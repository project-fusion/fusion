{
  "name": "@fusion.dev/proof",
  "description": "Fusion Proof, visual regression testing for any web project, with baselines kept in git.",
  "version": "0.0.0-dev",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "proof/cli/npm",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.mjs"
    }
  },
  "files": [
    "bin.mjs",
    "driver.mjs",
    "index.mjs",
    "types"
  ],
  "bin": {
    "proof": "./bin.mjs"
  },
  "scripts": {
    "test": "bun test"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "homepage": "https://fusion.dev",
  "keywords": [
    "proof",
    "cli",
    "playwright",
    "screenshot",
    "visual-regression"
  ],
  "optionalDependencies": {
    "@fusion.dev/proof-darwin-arm64": "workspace:*",
    "@fusion.dev/proof-darwin-x64": "workspace:*",
    "@fusion.dev/proof-linux-arm64": "workspace:*",
    "@fusion.dev/proof-linux-x64": "workspace:*",
    "@fusion.dev/proof-win32-x64": "workspace:*"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "peerDependencies": {
    "playwright": ">=1.50"
  }
}
