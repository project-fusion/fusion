{
  "name": "@fusion-io/site-ui",
  "description": "fusion.dev: the landing page, the verticals, and the tools under them.",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run wasm && bun run catalog && bun run frame && bun run specs && next build",
    "catalog": "bun ../../tooling/scripts/build-catalog.mjs",
    "dev": "bun run wasm && bun run catalog && bun run frame && bun run specs && next dev --port 3000",
    "frame": "bun ../../tooling/scripts/build-frame.mjs",
    "specs": "bun ../../tooling/scripts/build-specs.mjs",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wasm": "node ../../tooling/scripts/build-wasm.mjs"
  },
  "dependencies": {
    "@fusion-io/site-content": "workspace:*",
    "@helix-io/docs": "workspace:*",
    "@helix-io/gallery": "workspace:*",
    "@helix-io/sandbox": "workspace:*",
    "@helix-io/styles": "workspace:*",
    "@helix-io/theme": "workspace:*",
    "@helix-io/web": "workspace:*",
    "next": "^16.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1"
  }
}
