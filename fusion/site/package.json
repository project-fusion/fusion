{
  "name": "@fusion.dev/site",
  "description": "fusion.dev: the landing page, the verticals, and the tools under them.",
  "version": "0.0.0-dev",
  "private": true,
  "license": "MIT",
  "repository": {
    "directory": "fusion/site",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "scripts": {
    "build": "next build && bun scripts/check-highlight.mjs",
    "catalog": "bun scripts/build-catalog.mjs",
    "dev": "bun scripts/dev.mjs",
    "faces": "bun scripts/build-faces.mjs",
    "frame": "bun scripts/build-frame.mjs",
    "maplibre-copy": "bun scripts/copy-maplibre.mjs",
    "routes": "bun scripts/check-routes.mjs",
    "routes-check": "bun scripts/check-routes.mjs --check",
    "specs": "bun scripts/build-specs.mjs",
    "speech-copy": "bun scripts/copy-speech.mjs",
    "start": "next start",
    "themed-page": "bun scripts/build-themed-page.mjs",
    "themed-page-check": "bun scripts/build-themed-page.mjs --check",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "wasm-copy": "bun scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@cosmos.gl/graph": "^3.5.1",
    "@fusion.dev/helix": "workspace:*",
    "@fusion.dev/helix-cem": "workspace:*",
    "@fusion.dev/helix-code-editor": "workspace:*",
    "@fusion.dev/helix-core": "workspace:*",
    "@fusion.dev/helix-docs": "workspace:*",
    "@fusion.dev/helix-editor": "workspace:*",
    "@fusion.dev/helix-gallery": "workspace:*",
    "@fusion.dev/helix-graph": "workspace:*",
    "@fusion.dev/helix-icons": "workspace:*",
    "@fusion.dev/helix-map": "workspace:*",
    "@fusion.dev/helix-plot": "workspace:*",
    "@fusion.dev/helix-sandbox": "workspace:*",
    "@fusion.dev/helix-speech": "workspace:*",
    "@fusion.dev/helix-styles": "workspace:*",
    "@fusion.dev/helix-terminal": "workspace:*",
    "@fusion.dev/helix-theme": "workspace:*",
    "@fusion.dev/helix-workbench": "workspace:*",
    "@fusion.dev/insights": "workspace:*",
    "@luma.gl/core": "~9.3.6",
    "@luma.gl/engine": "~9.3.6",
    "@luma.gl/shadertools": "~9.3.6",
    "@luma.gl/webgl": "~9.3.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "d3-force-3d": "^3.0.6",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "maplibre-gl": "^6.13.0",
    "next": "^16.4.0",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.3",
    "sigma": "^4.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fusion.dev/helix-testing": "workspace:*",
    "@fusion.dev/scripts": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "meshoptimizer": "^1.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1"
  }
