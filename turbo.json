{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "analyze": {
      "dependsOn": ["^build", "build"],
      "inputs": ["src/**", "custom-elements-manifest.config.ts"],
      "outputs": ["custom-elements.json"]
    },
    "build": {
      "dependsOn": ["^build", "^analyze", "icons", "styles"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "icons": {
      "inputs": ["raw/**", "$TURBO_ROOT$/tooling/scripts/build-icons.mjs"],
      "outputs": ["src/generated.ts"]
    },
    "styles": {
      "inputs": [
        "src/**/*.css",
        "$TURBO_ROOT$/tooling/scripts/build-styles.mjs",
        "$TURBO_ROOT$/tooling/scripts/build-elements-css.mjs"
      ],
      "outputs": ["src/**/*.css.ts"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    }
  },
  "ui": "stream"
}
