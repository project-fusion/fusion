{
  "$schema": "https://turbo.build/schema.json",
  // The compiler options every package extends live at the root, where a
  // package's own inputs do not reach: an edit to one of these changed every
  // `dist` and invalidated no cache.
  "globalDependencies": ["tsconfig.base.json", "tsconfig.package.json", "tsconfig.types.json"],
  // **The platform is part of the hash, because turbo does not put it there and
  // the artifacts differ by it.** Measured 25 Aug 2026, the day the remote cache
  // started working: CI restored a build this laptop had written, and
  // `check:gen:metrics` then reported `@fusion.dev/helix-theme` at 566,424 bytes over 16
  // files where a Linux build produces 465,772 over 8. A check whose answer
  // depends on which machine warmed the cache is not a check.
  //
  // `RUNNER_OS` and `RUNNER_ARCH` are set by GitHub Actions and unset on a
  // desk, so the two populations never share an entry. What matters is kept:
  // every job in a run is Linux, so the check shards and the browser
  // shards still restore each other's build, which is where the saving was.
  // Nothing is lost but a laptop feeding a runner, which is the thing that
  // broke.
  //
  // A first-class platform key would be better than borrowing two environment
  // variables from one CI provider. Turborepo has none, so this is the idiom
  // rather than a preference.
  "globalEnv": ["RUNNER_ARCH", "RUNNER_OS"],
  // `GITHUB_OUTPUT` is read by `fusion/scripts/version.mjs`, which hands the
  // resolved release version back to the workflow that asked for it. Declared
  // so the lint that watches for undeclared environment access stays
  // meaningful. `NODE_AUTH_TOKEN` was here too and nothing sets it: the
  // release publishes by OIDC, and RELEASING.md says its presence would stop
  // that exchange.
  "globalPassThroughEnv": ["GITHUB_OUTPUT"],
  "tasks": {
    // `metrics` and `docs` run at the head of this build, so what they write is
    // build output and an undeclared one is what a cache hit does not restore.
    //
    // **Here and not on the shared `build`, because of the last one.** A
    // package-relative glob there would be harmless, resolving under each
    // package to a path that does not exist. `$TURBO_ROOT$` does not: every
    // package's build would claim the one absolute path, and a cache hit on any
    // of them restores its own empty set over it. `claims.generated.ts` belongs
    // to the site and is written from here because one pass over the packages
    // produces it and `metrics.mdx` together; the site depends on this package,
    // so `^build` puts it on disk before anything reads it.
    // **`docs`, and through it `metrics`, before `tsc` reads what they write.**
    // `docs` is uncached and always runs, and `metrics` restores its outputs on
    // a hit, so what they leave on disk is there for a cache hit that restores
    // only `dist`. `typecheck` and `test` below want the same ordering for the
    // same reason: one reads the generated modules, the other imports them.
    "@fusion.dev/helix-docs#build": {
      "dependsOn": ["^build", "^analyze", "analyze", "icons", "styles", "docs"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts"],
      "outputs": ["dist/**"]
    },
    "@fusion.dev/helix-docs#test": {
      "dependsOn": ["^build", "analyze", "docs"],
      "inputs": ["src/**", "tests/**"],
      "outputs": []
    },
    "@fusion.dev/helix-docs#typecheck": {
      "dependsOn": ["^build", "^analyze", "analyze", "docs"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    // The two tiers generate `element-events.generated.ts` from their own
    // manifest before `tsc` reads it, so it is a build output and has to be
    // declared: an undeclared one is what a cache hit does not restore, and a
    // hit then reports success over a tree missing a module `index.ts` imports.
    "@fusion.dev/helix-headless#build": {
      "dependsOn": ["^build", "^analyze", "analyze", "icons", "styles"],
      "outputs": ["dist/**", "src/element-events.generated.ts"]
    },
    // **The tiers' `typecheck` waits for their own `build`, because the examples
    // are consumers.** `typecheck` runs `tsconfig.examples.json` after the
    // sources, and an example reaches the package it sits beside by name:
    // `import type { HelixVideo } from '@fusion.dev/helix'`, the way the
    // typings it is checked against reach every element class. That resolves
    // through `exports` to `dist`, which the shared `typecheck` never asked
    // for: on a clean checkout every such import is TS2307, and under
    // `skipLibCheck` the typings' own import degrades to `any` first, so the
    // examples would pass against nothing before failing on their imports.
    "@fusion.dev/helix-headless#typecheck": {
      "dependsOn": ["^build", "^analyze", "analyze", "build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    // `token-layer` writes `src/tokens.css` from `src/_modes.css` and the
    // registry, and `elements-css` writes `src/elements.css` from the tags in
    // `@fusion.dev/helix`, so both stylesheets are build outputs and have to be
    // declared here as well, or a cache hit leaves `styles-dist` nothing to
    // strip.
    //
    // **`elements-css` and not `^build`.** This package is what `@fusion.dev/helix`
    // depends on, so waiting for it to build would be a cycle. The generator
    // reads element source text and needs nothing compiled, which is what lets
    // the two be ordered at all.
    "@fusion.dev/helix-styles#build": {
      "dependsOn": ["^build", "^analyze", "analyze", "icons", "styles", "elements-css"],
      "outputs": ["dist/**", "src/tokens.css", "src/elements.css"]
    },
    "@fusion.dev/helix#build": {
      "dependsOn": ["^build", "^analyze", "analyze", "icons", "styles"],
      "outputs": ["dist/**", "src/element-events.generated.ts"]
    },
    // The same wait as the headless tier's, above, for the same examples.
    "@fusion.dev/helix#typecheck": {
      "dependsOn": ["^build", "^analyze", "analyze", "build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    // **`pages.generated.ts` is written here, not read here**, and declaring it
    // as an input was the same mistake `docs` carried: a file a task writes and
    // does not declare is a file a cache hit leaves at whatever the last run put
    // there, while the generated module beside it is restored fresh. The two
    // then disagree and only `-- --check` notices.
    "@fusion.dev/insights#build": {
      "dependsOn": ["^build"],
      "outputs": ["src/pages.generated.ts", "src/sources.generated.ts"]
    },
    // **The generators are tasks this depends on, not a chain the script runs.**
    // `build` was `faces && themed-page && catalog && frame && specs && next
    // build`, which ran all five on every build and every typecheck whether or
    // not their inputs had moved, and put a fetch of Google's font list in
    // front of `tsc`. Declared here, each answers from its own cache, `faces`
    // still runs every time because it says so, and `next build` waits for all
    // of them.
    //
    // **What they write is theirs to declare, not this task's.** The frame, the
    // specs and the font list were in these `outputs` while the script wrote
    // them; left here, a cache hit on the build would restore its own snapshot
    // of them over what the task that just ran had written.
    //
    // **The font list is an input, named, because `$TURBO_DEFAULT$` reads git
    // and the file is ignored.** `faces` is uncached so that a cache hit cannot
    // pin what Google answered once, and this is the other half of that: a
    // build that did not read the list would hit on a `.next` prerendered from
    // the previous answer.
    "@fusion.dev/site#build": {
      "dependsOn": [
        "^build",
        "^analyze",
        "analyze",
        "icons",
        "styles",
        "faces",
        "themed-page",
        "catalog",
        "frame",
        "specs",
        "wasm-copy"
      ],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "content/faces/faces.generated.ts"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    // `next dev` reads the same generated files the build does, and `dev.mjs`
    // keeps the catalog and the frame current beside it. Uncached and
    // persistent as the shared `dev` is; what is added is the order.
    "@fusion.dev/site#dev": {
      "cache": false,
      "dependsOn": ["^build", "faces", "themed-page", "catalog", "frame", "specs", "wasm-copy"],
      "persistent": true
    },
    // `tsc` imports the catalog, the font list and the themed page's markup,
    // all generated, so the same five run first. Not `wasm-copy`: nothing
    // typed reads the binary.
    "@fusion.dev/site#typecheck": {
      "dependsOn": [
        "^build",
        "^analyze",
        "analyze",
        "faces",
        "themed-page",
        "catalog",
        "frame",
        "specs"
      ],
      "inputs": ["$TURBO_DEFAULT$", "content/faces/faces.generated.ts"],
      "outputs": []
    },
    // `cem analyze` writes four files and this used to claim one, then three.
    // The manifest is the obvious output; `jsx.d.ts`, `vue.d.ts` and
    // `svelte.d.ts` are written beside it by the framework plugins, and an
    // output a task does not declare is one a cache hit does not restore.
    //
    // `svelte.d.ts` was the one still missing, and it was invisible while the
    // file was tracked: a cache hit left the working copy alone because git
    // already held it. Untracked, the same cache hit leaves nothing at all, and
    // `files` names it, so the package would ship without the typings a Svelte
    // consumer imports.
    // Its own `build` was in `dependsOn` and did not belong: the config imports
    // `@fusion.dev/helix-cem`, which `^build` already covers, and a manifest
    // built with `dist` absent is byte-identical to one built beside it,
    // measured at 75,232 lines on `helix/headless`. Removing it is what lets
    // `build` depend on `analyze` instead, so a tier can generate
    // `element-events.generated.ts` as a prebuild step rather than tracking it.
    //
    // **`$TURBO_DEFAULT$`, so no generated file is an input, because turbo
    // hashes the tree as it stands when a run starts.** A clean checkout has
    // none of them and a second run in the same job has them all, so `src/**`
    // gave this task two keys for one source: `bun run analyze` straight after
    // `bun run build` missed, and so did every `build` depending on it. Measured
    // on CI 15 Sep 2026, fourteen tasks rebuilt in 81 seconds, paid again by
    // every job that ran a second turbo command. What the default reads that
    // `src/**` did not is the package's other tracked files, `package.json`
    // among them, which the analyzer reads for `exports`.
    //
    // The generated files it leaves out are each accounted for. The analyzer
    // does not read `element-events.generated.ts`, which is written from this
    // task's output. It does read each `.css.ts`, which is `styles`' output, so
    // `styles` is a dependency: its hash stands for them, and the analyzer no
    // longer races it for whether they exist yet.
    "analyze": {
      "dependsOn": ["^build", "styles"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["custom-elements.json", "types/jsx.d.ts", "types/svelte.d.ts", "types/vue.d.ts"]
    },
    "build": {
      "dependsOn": ["^build", "^analyze", "analyze", "icons", "styles"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts"],
      // **`wasm/**` was here and had to go, because a cache hit was deleting
      // tracked files.** It was declared when `@fusion.dev/helix-theme`'s build made
      // the wasm, so restoring it alongside `dist` was right. 273 tracked the
      // artifact and made that build `tsc` alone, and a declared output turbo
      // manages: the cached set for `wasm/**` is empty, so every cache hit
      // replaced four tracked files with nothing. Reproduced on 25 Aug 2026,
      // `git status` showing all four deleted, and measured in CI first as
      // `@fusion.dev/helix-theme` shipping 8 files where the tree holds 16.
      //
      // A tracked source is never a task output. `files` still publishes
      // `wasm`, `turbo run wasm-check` still measures it, and nothing builds it here.
      //
      // **The other half: a generated file that nothing tracks must be
      // declared, by the task that writes it.** `public/sandbox` and
      // `public/specs` were written by the site's build script and declared by
      // nothing, so a cache hit restored `.next` and not `frame.html`, and every
      // browser job failed one second in with `Cannot read properties of null
      // (reading 'querySelectorAll')`. They are `frame`'s and `specs`' outputs
      // now, and the site's own entry above names only what `next build`
      // writes.
      "outputs": ["dist/**"]
    },
    // Reads the manifests and every `.examples` file, so it depends on the
    // analyzer having run: `analyze` writes `custom-elements.json`, and a
    // catalog built before it would describe whatever the last analysis left.
    "catalog": {
      "dependsOn": ["^build", "^analyze"],
      "inputs": [
        "$TURBO_ROOT$/helix/docs/src/catalog.ts",
        "$TURBO_ROOT$/helix/docs/src/naming.ts",
        "$TURBO_ROOT$/helix/docs/content/**",
        "$TURBO_ROOT$/helix/docs/src/reference.ts",
        "content/routes/routes.ts",
        "$TURBO_ROOT$/helix/headless/custom-elements.json",
        "$TURBO_ROOT$/helix/sandbox/custom-elements.json",
        "$TURBO_ROOT$/helix/styled/custom-elements.json",
        "$TURBO_ROOT$/helix/styled/src/*/.examples/**",
        "$TURBO_ROOT$/fusion/docs/insights/**",
        "$TURBO_ROOT$/fusion/site/scripts/build-catalog.mjs"
      ],
      // **`public/insights` is an output and was not declared**, which is the
      // same fault this file records two tasks down about `public/sandbox` and
      // `public/specs`. `routes` asks whether every published path has a
      // document under `public/insights`, so a cache hit restored a tree
      // without them and the check reported six essays as having no document.
      // The insights content is an input for the other half of it: six essays
      // were added and the cache key did not move, so the task that writes
      // those documents was never asked to run again.
      //
      // The set is `.gitignore`'s, which is the list of what this task
      // generates and the only place it was written down: `public/*.md`,
      // `public/helix/*.md`, `public/helix/components/`, `public/helix/docs/`
      // and `public/insights/`. Declaring them one failure at a time found
      // `insights` and then `helix/*.md` on the next run, because a `.md` is
      // written per route and a route is as deep as its path.
      "outputs": [
        "content/catalog/catalog.generated.json",
        "public/*.md",
        "public/helix/components/**",
        "public/helix/docs/**",
        "public/helix/*.md",
        "public/insights/**"
      ]
    },
    "content": {
      "inputs": ["content/**", "scripts/build-content.mjs"],
      "outputs": ["src/pages.generated.ts", "src/sources.generated.ts"]
    },

    // **`^build`, because the site's `dev` runs `catalog` and that reads a
    // generated module.** `catalog` imports `@fusion.dev/helix-docs`'s registry,
    // which imports `pages.generated.js`; nothing in the dev chain writes it and
    // nothing tracks it any more. It was committed until the generated files
    // stopped being, so this got away with having no dependencies at all, and
    // `bun dev` failed on a clean tree with `Cannot find module
    // './pages.generated.js'`. `typecheck` runs the same `catalog` and never saw
    // it, having carried `^build` the whole time.
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },

    // **Not cached, and it took a stale cache hit to see why.** This writes the
    // token tables back into the `content/*.mdx` it reads, so its inputs are
    // also its outputs: a run changes the key it would have been stored under,
    // and the next hit restores the two generated modules without the mdx edits
    // that produced them. The tree then holds a generated file and a source that
    // disagree, and `-- --check` says stale while the plain task reports
    // success from a replayed log. `samples` has the same shape and the same
    // answer.
    "docs": { "cache": false, "dependsOn": ["^build", "metrics"] },
    // Reads `@customElement('tag')` out of the element sources and writes the
    // sheet that hides each one until it upgrades. A workspace step rather than
    // a package's, because it reads one package and writes another.
    //
    // **The generated modules beside the sources are not inputs**, because the
    // script does not read them: `build-elements-css.mjs` says why, and the two
    // lists have to agree.
    "elements-css": {
      "inputs": [
        "$TURBO_ROOT$/helix/styled/src/**/*.ts",
        "!$TURBO_ROOT$/helix/styled/src/**/*.css.ts",
        "!$TURBO_ROOT$/helix/styled/src/**/*.generated.ts",
        "$TURBO_ROOT$/fusion/scripts/build-elements-css.mjs"
      ],
      "outputs": ["$TURBO_ROOT$/helix/styles/src/elements.css"]
    },

    // **Four that cannot cache, each for its own reason, said rather than
    // discovered.** `faces` fetches a font list over the network, so a cache hit
    // would pin whatever Google answered the first time. `peers` installs four
    // component libraries into a scratch directory and weighs them. `timings`
    // measures `performance.now()`, which is not a function of its inputs.
    // `wasm-check` derives seventeen themes through the tracked binary, which is
    // the artifact it exists to distrust.
    "faces": { "cache": false },
    // The fourth layer is `helix/styles/src/elements.css`, and it was not in
    // `inputs`, so editing any component stylesheet did not invalidate this.
    // `dependsOn` orders the two tasks and ordering is not invalidation: the
    // sandbox stylesheet, which is also what the browser spec runner serves as
    // its whole token layer, could sit a build behind the components it is
    // meant to paint.
    "frame": {
      "dependsOn": ["^build"],
      "inputs": [
        "preview/preview-frame-entry.ts",
        "preview/preview-frame.css",
        "public/fonts/**",
        "$TURBO_ROOT$/helix/styles/src/*.css",
        "$TURBO_ROOT$/helix/styles/src/elements.css",
        "$TURBO_ROOT$/fusion/site/scripts/build-frame.mjs"
      ],
      "outputs": ["public/sandbox/**"]
    },
    "icons": {
      "inputs": ["icons.txt", "raw/**", "$TURBO_ROOT$/helix/icons/scripts/build-icons.mjs"],
      "outputs": ["src/generated.ts"]
    },
    // **The three tiers by name, because no dependency edge reaches them.**
    // `helix/docs` devDepends on the manifest reader and the shared scripts and
    // on neither tier, while this measures `dist/index.js` for both and the
    // stylesheets `helix-styles` ships. Ordered only by `^build` the docs built
    // first and the generator exited on a missing `helix/headless/dist`.
    //
    // `helix-theme` for the same reason: it is a row in the package table and
    // nothing any tier depends on, so without it the theme's `dist` is whatever
    // is on disk, and on a clean tree nothing, which fails the bundle outright.
    //
    // **The inputs are what the script reads, and the script was the only one
    // declared.** It also reads `peers.json` and `timings.json` for the two
    // comparison sections, every other page's frontmatter to place its own
    // page last in the section, and the six manifests' `files` for the unpacked
    // footprints. With only the script hashed, a cache hit answered from a
    // metrics page measured before any of those moved. `metrics.mdx` is the
    // output and is kept out of the pages read.
    //
    // **The judge does not run through turbo, and that is the one exception to
    // `-- --check`.** Pass-through arguments go into the hash of every task in
    // a run and reach only the task that was named, so `turbo run docs --
    // --check` runs this as a writer under the judge's hash. Measured 14 Sep
    // 2026: `turbo run metrics -- --check` after it replayed `build-metrics`
    // and reported the page written, never having compared anything. The
    // writer is `turbo run metrics` and the judge is
    // `bun fusion/scripts/build-metrics.mjs --check`, which no cache can
    // answer for. It skips its own measurement only on the receipt a write on
    // the same machine left for the same inputs, which a restore never brings,
    // so `verify` measures a changed tree once rather than twice.
    "metrics": {
      "dependsOn": [
        "@fusion.dev/helix#build",
        "@fusion.dev/helix-headless#build",
        "@fusion.dev/helix-styles#build",
        "@fusion.dev/helix-theme#build"
      ],
      "inputs": [
        "content/*.mdx",
        "!content/metrics.mdx",
        "peers.json",
        "timings.json",
        "$TURBO_ROOT$/fusion/scripts/build-metrics.mjs",
        "$TURBO_ROOT$/helix/core/package.json",
        "$TURBO_ROOT$/helix/headless/package.json",
        "$TURBO_ROOT$/helix/icons/package.json",
        "$TURBO_ROOT$/helix/styled/package.json",
        "$TURBO_ROOT$/helix/styles/package.json",
        "$TURBO_ROOT$/helix/theme/package.json"
      ],
      "outputs": [
        "content/metrics.mdx",
        "$TURBO_ROOT$/fusion/site/content/landing/claims.generated.ts"
      ]
    },
    "peers": { "cache": false },

    // Reads the manifest, so it waits for whoever writes one.

    // **Three more that declare a task without caching it, which is a real
    // answer rather than a gap.** `tokens` counts every read of every token
    // across two whole domains, so its key changes on nearly every commit and a
    // cache would cost a hash to miss. `routes` is the same shape one step over.
    // `samples` writes back into the files it reads, so its own output changes
    // the key it was stored under and the next run always misses. Declared
    // anyway, because `turbo run` needs the declaration and because a task in
    // the graph can be depended on.
    // The register the Rust door reads, generated from the TypeScript one the
    // JavaScript door imports. Not cached: it is one file from one file and the
    // check is cheaper than a cache lookup.
    "register": { "cache": false },
    // `routes` reads the documents `catalog` writes under `public/`, so it
    // waits for it: run alone from `check:gen` or the hook it judged whatever
    // the last catalog had left, and on a clean tree that is nothing.
    "routes": { "cache": false, "dependsOn": ["catalog"] },
    "samples": { "cache": false },

    "specs": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_ROOT$/helix/headless/src/**/*.dom.spec.ts",
        "$TURBO_ROOT$/helix/styled/src/**/*.dom.spec.ts",
        "$TURBO_ROOT$/helix/testing/src/browser.ts",
        "$TURBO_ROOT$/fusion/site/scripts/build-specs.mjs"
      ],
      "outputs": ["public/specs/**"]
    },
    // Two generators, two outputs. `build-styles.mjs` writes the `.css.ts`
    // mirrors and `build-elements-css.mjs` writes `elements.css` at the package
    // root, and only the first was declared. Measured: delete `elements.css`
    // with a warm cache and `turbo run styles` prints "2 successful, 2 total"
    // while the file stays missing, because a cache hit restores what a task
    // claims and nothing else. The next thing to read it fails, which is how
    // this was found: `build-frame.mjs` on ENOENT.
    //
    // **The two layers `helix-styles` generates into its `src` are not
    // inputs**, for the reason `analyze` gives: hashed, they gave the task one
    // key on a clean checkout and another once a build had written them, and
    // every `build` above it missed on the second. That package has no
    // `styles` script, and the hash of the task it does not have is still one
    // its own `build` depends on.
    "styles": {
      "inputs": [
        "src/**/*.css",
        "!src/elements.css",
        "!src/tokens.css",
        "$TURBO_ROOT$/fusion/scripts/build-styles.mjs",
        "$TURBO_ROOT$/fusion/scripts/build-elements-css.mjs"
      ],
      "outputs": ["src/**/*.css.ts"]
    },

    "styles-dist": {
      "inputs": ["src/**", "$TURBO_ROOT$/helix/styles/scripts/build-styles-dist.mjs"],
      "outputs": ["dist/**"]
    },
    // **`analyze`, because two packages generate a source file from their own
    // manifest.** `element-events` reads `custom-elements.json`, and the tiers
    // run it before their specs. Without it here the task graph is free to run
    // the specs first, and it did: CI failed on
    // `Cannot find module './element-events.generated.js'` while every local
    // run passed on a file an earlier build had left behind.
    "test": {
      "dependsOn": ["^build", "analyze"],
      "inputs": ["src/**", "tests/**"],
      "outputs": []
    },

    // Renders React to markup, so it reads the pages it renders.
    //
    // **A wildcard segment where the route group is**, because a route group is
    // written in parentheses and parentheses are alternation to a glob parser:
    // the literal path fails to parse rather than matching nothing, which is the
    // better of the two ways for that to go wrong.
    "themed-page": {
      "dependsOn": ["^build"],
      "inputs": ["app/*/helix/theme/**", "$TURBO_ROOT$/fusion/site/scripts/build-themed-page.mjs"],
      "outputs": ["app/*/helix/theme/themed-page-markup.generated.ts"]
    },
    "timings": { "cache": false },

    // **The generators, one task each, and the reason is the cache rather than
    // the spelling.** Each of these was a root alias reading `--filter <pkg>
    // <script>`, which ran every time it was called; eight of them run in
    // `verify`. Declared here they answer from cache when nothing they read has
    // moved, and `turbo run <task> -- --check` passes the flag through and into
    // the hash, so the generate and the compare are one task rather than two
    // aliases.
    //
    // **An output not declared is one a cache hit does not restore**, which was
    // invisible while these artifacts were tracked and is not any more. Every
    // `outputs` below names everything its script writes.

    // `src/tokens.ts` is the whole input: the layer is spelled there and this
    // writes both the stylesheet block and the registry the docs read.
    // **Uncached, because one of its outputs is partly written by hand.**
    //
    // Cacheable since `src/tokens.css` became wholly generated: the hand-written
    // half moved to `src/_modes.css`, so inputs and outputs no longer overlap.
    // It was `cache: false` while the generator replaced a region inside a file
    // it also had to preserve, which turbo cannot express: a hit restored the
    // cached copy over anything hand-written since, reproduced 31 Aug 2026 as a
    // block that survived a run and vanished on the next reporting FULL TURBO.
    "token-layer": {
      "inputs": [
        "src/_modes.css",
        "src/tokens.ts",
        "$TURBO_ROOT$/helix/styles/scripts/build-token-layer.mjs"
      ],
      "outputs": ["src/tokens.css", "dist/tokens.json"]
    },
    // **`^analyze` and not only `^build`, because the typings are analyzer
    // output.** `jsx.d.ts` is emitted by `analyze` and is gitignored, so on a
    // clean checkout there is nothing on disk for the site's
    // `import '@fusion.dev/helix-sandbox/jsx'` to contribute: every custom
    // element written in JSX becomes an unknown `JSX.IntrinsicElements` member.
    // It passed locally the whole time, because a developer who has ever run
    // `analyze` has the file. Four errors across two site files, and the job
    // that catches it runs `bun install` and `typecheck` and nothing between.
    // `analyze` for the reason `test` gives: `typecheck` runs `element-events`
    // first in the two tiers, and that reads the manifest.
    "typecheck": {
      "dependsOn": ["^build", "^analyze", "analyze"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "wasm-check": { "cache": false },
    // The site serves the theme engine as a static file, and the file is a copy
    // of the tracked binary in `helix/theme/wasm`. It was tracked twice, byte
    // for byte, with `build-wasm.mjs` writing both; now the copy is build output
    // like the frame, and the tracked one is the only source.
    "wasm-copy": {
      "inputs": [
        "$TURBO_ROOT$/helix/theme/wasm/fusion_helix_theme_bg.wasm",
        "$TURBO_ROOT$/fusion/site/scripts/copy-wasm.mjs"
      ],
      "outputs": ["public/helix/theme.wasm"]
    }
  },
  "ui": "stream"
}
