{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "analyze": {
      "dependsOn": ["^build", "build"],
      "inputs": ["src/**", "custom-elements-manifest.config.mjs"],
      "outputs": ["custom-elements.json"]
    },
    "build": {
      "dependsOn": ["^build", "^analyze"],
      "inputs": ["src/**", "scripts/**", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json"],
      "outputs": []
    }
  },
  "ui": "stream"
}
