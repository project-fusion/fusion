{
  "$schema": "https://turbo.build/schema.json",
  // Read by `fusion/scripts/version.mjs`, which hands the resolved release
  // version back to the workflow that asked for it. Declared so the lint that
  // watches for undeclared environment access stays meaningful.
  // **The platform is part of the hash, because turbo does not put it there and
  // the artifacts differ by it.** Measured 25 Aug 2026, the day the remote cache
  // started working: CI restored a build this laptop had written, and
  // `check:gen:metrics` then reported `@fusion.dev/helix-theme` at 566,424 bytes over 16
  // files where a Linux build produces 465,772 over 8. A check whose answer
  // depends on which machine warmed the cache is not a check.
  //
  // `RUNNER_OS` and `RUNNER_ARCH` are set by GitHub Actions and unset on a
  // desk, so the two populations never share an entry. What matters is kept:
  // every job in a run is Linux, so the six check shards and four browser
  // shards still restore each other's build, which is where the saving was.
  // Nothing is lost but a laptop feeding a runner, which is the thing that
  // broke.
  //
  // A first-class platform key would be better than borrowing two environment
  // variables from one CI provider. Turborepo has none, so this is the idiom
  // rather than a preference.
  "globalEnv": ["RUNNER_ARCH", "RUNNER_OS"],
  "globalPassThroughEnv": ["GITHUB_OUTPUT", "NODE_AUTH_TOKEN"],
  "tasks": {
    // `cem analyze` writes four files and this used to claim one, then three.
    // The manifest is the obvious output; `jsx.d.ts`, `vue.d.ts` and
    // `svelte.d.ts` are written beside it by the framework plugins, and an
    // output a task does not declare is one a cache hit does not restore.
    //
    // `svelte.d.ts` was the one still missing, and it was invisible while the
    // file was tracked: a cache hit left the working copy alone because git
    // already held it. Untracked, the same cache hit leaves nothing at all, and
    // `files` names it, so the package would ship without the typings a Svelte
    // consumer imports.
    "analyze": {
      "dependsOn": ["^build", "build"],
      "inputs": ["src/**", "custom-elements-manifest.config.ts"],
      "outputs": ["custom-elements.json", "jsx.d.ts", "svelte.d.ts", "vue.d.ts"]
    },
    "build": {
      "dependsOn": ["^build", "^analyze", "icons", "styles"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts"],
      // **`wasm/**` was here and had to go, because a cache hit was deleting
      // tracked files.** It was declared when `@fusion.dev/helix-theme`'s build made
      // the wasm, so restoring it alongside `dist` was right. 273 tracked the
      // artifact and made that build `tsc` alone, and a declared output turbo
      // manages: the cached set for `wasm/**` is empty, so every cache hit
      // replaced four tracked files with nothing. Reproduced on 25 Aug 2026,
      // `git status` showing all four deleted, and measured in CI first as
      // `@fusion.dev/helix-theme` shipping 8 files where the tree holds 16.
      //
      // A tracked source is never a task output. `files` still publishes
      // `wasm`, `check:css:wasm` still measures it, and nothing builds it here.
      //
      // **`public/sandbox` and `public/specs` are outputs and were not declared,
      // which is the mirror of the `wasm` fault and cost four CI jobs.** The
      // site's build is `catalog && frame && specs && next build`, so a cache hit
      // skips all four and restores only what is listed: `.next` came back,
      // `frame.html` did not, and both directories are gitignored so nothing else
      // could put them there. Every browser job then failed one second in with
      // `Cannot read properties of null (reading 'querySelectorAll')`, because
      // `preview-root` lives in the frame that was never written. Red since the
      // remote cache started hitting, and never for a reason in the code.
      //
      // The `wasm` lesson was that a tracked file must not be declared. This is
      // the other half: a generated file that nothing tracks must be.
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "public/sandbox/**", "public/specs/**"]
    },
    // The fourth layer is `helix/styled/elements.css` and it was not in `inputs`,
    // so editing any component stylesheet did not invalidate this. `dependsOn`
    // orders the two tasks and ordering is not invalidation: the sandbox
    // stylesheet, which is also what the browser spec runner serves as its
    // whole token layer, could sit a build behind the components it is meant to
    // paint.
    // Reads the manifests and every `.examples` file, so it depends on the
    // analyzer having run: `analyze` writes `custom-elements.json`, and a
    // catalog built before it would describe whatever the last analysis left.
    "catalog": {
      "dependsOn": ["^build", "^analyze"],
      "inputs": [
        "$TURBO_ROOT$/helix/docs/src/catalog.ts",
        "$TURBO_ROOT$/helix/docs/src/naming.ts",
        "$TURBO_ROOT$/helix/docs/content/**",
        "$TURBO_ROOT$/helix/docs/src/reference.ts",
        "content/routes/routes.ts",
        "$TURBO_ROOT$/helix/headless/custom-elements.json",
        "$TURBO_ROOT$/helix/sandbox/custom-elements.json",
        "$TURBO_ROOT$/helix/styled/custom-elements.json",
        "$TURBO_ROOT$/helix/styled/src/*/.examples/**",
        "$TURBO_ROOT$/fusion/site/scripts/build-catalog.mjs"
      ],
      "outputs": [
        "content/catalog/catalog.generated.json",
        "public/*.md",
        "public/helix/components/**",
        "public/helix/docs/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "frame": {
      "dependsOn": ["^build"],
      "inputs": [
        "preview/preview-frame-entry.ts",
        "preview/preview-frame.css",
        "public/fonts/**",
        "$TURBO_ROOT$/helix/styles/src/*.css",
        "$TURBO_ROOT$/helix/styled/elements.css",
        "$TURBO_ROOT$/fusion/site/scripts/build-frame.mjs"
      ],
      "outputs": ["public/sandbox/**"]
    },
    "icons": {
      "inputs": ["icons.txt", "raw/**", "$TURBO_ROOT$/helix/icons/scripts/build-icons.mjs"],
      "outputs": ["src/generated.ts"]
    },
    // Two generators, two outputs. `build-styles.mjs` writes the `.css.ts`
    // mirrors and `build-elements-css.mjs` writes `elements.css` at the package
    // root, and only the first was declared. Measured: delete `elements.css`
    // with a warm cache and `bun run styles` prints "2 successful, 2 total"
    // while the file stays missing, because a cache hit restores what a task
    // claims and nothing else. The next thing to read it fails, which is how
    // this was found: `build-frame.mjs` on ENOENT.
    "styles": {
      "inputs": [
        "src/**/*.css",
        "$TURBO_ROOT$/fusion/scripts/build-styles.mjs",
        "$TURBO_ROOT$/fusion/scripts/build-elements-css.mjs"
      ],
      "outputs": ["src/**/*.css.ts", "elements.css"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    }
  },
  "ui": "stream"
}
