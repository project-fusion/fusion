{
  "$schema": "https://turbo.build/schema.json",
  // Read by `tooling/scripts/version.mjs`, which hands the resolved release
  // version back to the workflow that asked for it. Declared so the lint that
  // watches for undeclared environment access stays meaningful.
  "globalPassThroughEnv": ["GITHUB_OUTPUT", "NODE_AUTH_TOKEN"],
  "tasks": {
    // `cem analyze` writes three files and this used to claim one. The manifest
    // is the obvious output; `jsx.d.ts` and `vue.d.ts` are written beside it by
    // the JSX and Vue plugins, and an output a task does not declare is one a
    // cache hit does not restore.
    "analyze": {
      "dependsOn": ["^build", "build"],
      "inputs": ["src/**", "custom-elements-manifest.config.ts"],
      "outputs": ["custom-elements.json", "jsx.d.ts", "vue.d.ts"]
    },
    "build": {
      "dependsOn": ["^build", "^analyze", "icons", "styles"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts"],
      // **`wasm/**` was here and had to go, because a cache hit was deleting
      // tracked files.** It was declared when `@helix-io/theme`'s build made
      // the wasm, so restoring it alongside `dist` was right. 273 tracked the
      // artifact and made that build `tsc` alone, and a declared output turbo
      // manages: the cached set for `wasm/**` is empty, so every cache hit
      // replaced four tracked files with nothing. Reproduced on 25 Aug 2026,
      // `git status` showing all four deleted, and measured in CI first as
      // `@helix-io/theme` shipping 8 files where the tree holds 16.
      //
      // A tracked source is never a task output. `files` still publishes
      // `wasm`, `check:wasm` still measures it, and nothing builds it here.
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    // The fourth layer is `helix/styled/elements.css` and it was not in `inputs`,
    // so editing any component stylesheet did not invalidate this. `dependsOn`
    // orders the two tasks and ordering is not invalidation: the sandbox
    // stylesheet, which is also what the browser spec runner serves as its
    // whole token layer, could sit a build behind the components it is meant to
    // paint.
    // Reads the manifests and every `.examples` file, so it depends on the
    // analyzer having run: `analyze` writes `custom-elements.json`, and a
    // catalog built before it would describe whatever the last analysis left.
    "catalog": {
      "dependsOn": ["^build", "^analyze"],
      "inputs": [
        "$TURBO_ROOT$/helix/docs/src/catalog.ts",
        "$TURBO_ROOT$/helix/docs/src/naming.ts",
        "$TURBO_ROOT$/helix/docs/content/**",
        "$TURBO_ROOT$/helix/docs/src/reference.ts",
        "lib/routes.ts",
        "$TURBO_ROOT$/helix/headless/custom-elements.json",
        "$TURBO_ROOT$/helix/sandbox/custom-elements.json",
        "$TURBO_ROOT$/helix/styled/custom-elements.json",
        "$TURBO_ROOT$/helix/styled/src/*/.examples/**",
        "$TURBO_ROOT$/tooling/scripts/build-catalog.mjs"
      ],
      "outputs": [
        "lib/catalog.generated.json",
        "public/*.md",
        "public/helix/components/**",
        "public/helix/docs/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "frame": {
      "dependsOn": ["^build"],
      "inputs": [
        "lib/preview-frame-entry.ts",
        "lib/preview-frame.css",
        "app/fonts/**",
        "$TURBO_ROOT$/helix/styles/src/*.css",
        "$TURBO_ROOT$/helix/styled/elements.css",
        "$TURBO_ROOT$/tooling/scripts/build-frame.mjs"
      ],
      "outputs": ["public/sandbox/**"]
    },
    "icons": {
      "inputs": ["icons.txt", "raw/**", "$TURBO_ROOT$/tooling/scripts/build-icons.mjs"],
      "outputs": ["src/generated.ts"]
    },
    // Two generators, two outputs. `build-styles.mjs` writes the `.css.ts`
    // mirrors and `build-elements-css.mjs` writes `elements.css` at the package
    // root, and only the first was declared. Measured: delete `elements.css`
    // with a warm cache and `bun run styles` prints "2 successful, 2 total"
    // while the file stays missing, because a cache hit restores what a task
    // claims and nothing else. The next thing to read it fails, which is how
    // this was found: `build-frame.mjs` on ENOENT.
    "styles": {
      "inputs": [
        "src/**/*.css",
        "$TURBO_ROOT$/tooling/scripts/build-styles.mjs",
        "$TURBO_ROOT$/tooling/scripts/build-elements-css.mjs"
      ],
      "outputs": ["src/**/*.css.ts", "elements.css"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    }
  },
  "ui": "stream"
}
