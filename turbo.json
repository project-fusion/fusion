{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "analyze": {
      "dependsOn": ["^build", "build"],
      "inputs": ["src/**", "custom-elements-manifest.config.ts"],
      "outputs": ["custom-elements.json"]
    },
    "build": {
      "dependsOn": ["^build", "^analyze", "styles"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "styles": {
      "inputs": ["src/**/*.css"],
      "outputs": ["src/**/*.css.ts"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    }
  },
  "ui": "stream"
}
