#!/bin/sh
# Refuses a push whose generated files are behind their sources.
#
# This is the one class CI cannot fix for you: `verify.yml` runs everything else
# better than a laptop does, but it cannot regenerate. It judges and never
# writes, because a hook that edits the tree during `git push` produces a push
# that does not contain the edits.
#
# The bar for adding a check here is seconds rather than minutes, and a failure
# that is otherwise silent. A slow hook is one people pass `--no-verify` to.
#
# Installed by `git config core.hooksPath .githooks`, which `prepare` runs on
# `bun install`. Skip once with `git push --no-verify`.
set -e

# A runner installs this too, and none of it is a runner's job: `check:cli` runs
# a Rust binary a workflow has not built, so it fails here with no useful
# message. Measured 30 Aug 2026, when `Visual baselines` retook every picture,
# committed them, and died here on the push having opened no pull request.
[ -n "$CI" ] && exit 0

# `turbo` is a workspace binary and `sh -c` below does not get the PATH bun adds.
PATH="$PWD/node_modules/.bin:$PATH"
export PATH

# **Read first, because it is stdin**: git hands the hook one line per ref it
# is pushing, and those lines are the only way to know which commits a push
# brings. A step above this that read stdin would leave it nothing.
printf 'pre-push: withheld names\n'
pushing=$(cat)
printf '%s\n' "$pushing" | bun fusion/scripts/check-withheld.mjs --pushing >/tmp/pre-push-$$.log 2>&1 || {
  printf '\n'
  sed 's/^/  /' /tmp/pre-push-$$.log
  printf '\n'
  rm -f /tmp/pre-push-$$.log
  exit 1
}
rm -f /tmp/pre-push-$$.log

printf 'pre-push: formatting and lint\n'
bunx biome ci . >/dev/null 2>&1 || {
  printf '\n  biome refuses this tree. Run `bun run fix` and commit the result.\n\n'
  exit 1
}

# `reachable` is the rule that earned this line: it reads `:host([x])` against
# whether `x` reflects, and the fault it catches is silent every other way. The
# rest ride along because the whole set costs about a second.
printf 'pre-push: the rules that ship\n'
bun run check:cli >/tmp/pre-push-$$.log 2>&1 || {
  printf '\n'
  grep -v '^\$' /tmp/pre-push-$$.log | tail -4 | sed 's/^/  /'
  printf '\n'
  rm -f /tmp/pre-push-$$.log
  exit 1
}
rm -f /tmp/pre-push-$$.log

printf 'pre-push: generated files\n'
# This loop is the authority on the list, and it is kept in step with `regen` by
# hand: a writer whose `check:` is not here, or a check here whose writer is not
# in `regen`, is a red build with no published way out of it.
#
# Written out rather than built from a suffix. A name a shell assembles at run
# time is a name nothing can check, and `fusion workspace`'s `scripts` rule reads
# literal `bun run` calls.
for check in \
  "turbo run token-layer -- --check" \
  "turbo run docs -- --check" \
  "turbo run samples -- --check" \
  "turbo run routes -- --check" \
  "turbo run content -- --check" \
  "turbo run register -- --check" \
  "turbo run themed-page -- --check" \
  "bun run check:gen:element-events" \
  "bun run check:gen:metrics" \
  "bun run check:gen:eval"; do
  sh -c "$check" >/tmp/pre-push-$$.log 2>&1 || {
    printf '\n'
    grep -v '^\$' /tmp/pre-push-$$.log | tail -3 | sed 's/^/  /'
    printf '\n'
    rm -f /tmp/pre-push-$$.log
    exit 1
  }
done
rm -f /tmp/pre-push-$$.log

printf 'pre-push: clear\n'
