#!/bin/sh
# Checks what a push publishes, in seconds, before it leaves this machine.
#
# **Two checks, because only these two have to run before a push.** A withheld
# name in a commit message is public the moment the push lands, and CI can only
# report it afterwards. Formatting is the other: it is a check on the files the
# push changes, and it costs a second. Everything else this hook used to run is
# in `verify`, which CI runs on every push: `check:cli`, the generated-file
# checks, and `biome ci` over the whole tree.
#
# **Seconds, cold or warm.** The hook used to build the workspace for
# `check:cli` and the generated-file checks: 69 seconds in a fresh worktree and
# 28 with every cache warm, measured October 7, 2026. A slow hook is one people
# pass `--no-verify` to. It now builds nothing, so a fresh clone pays what a
# warm one does.
#
# **Biome reads the files the pushed commits change, and nothing else.** Another
# session's unfinished edit elsewhere in the checkout cannot block this push.
# It judges and never writes, because a hook that edits the tree during
# `git push` produces a push that does not contain the edits.
#
# Installed by `git config core.hooksPath .githooks`, which `prepare` runs on
# `bun install`. Skip once with `git push --no-verify`.
set -e

# A runner installs this too, and none of it is a runner's job: the push a
# workflow makes is checked by the workflow that made it.
[ -n "$CI" ] && exit 0

# `biome` is a workspace binary, and `sh` does not get the PATH bun adds.
PATH="$PWD/node_modules/.bin:$PATH"
export PATH

# **Read first, because it is stdin**: git hands the hook one line per ref it
# is pushing, and those lines are the only way to know which commits a push
# brings. A step above this that read stdin would leave it nothing.
pushing=$(cat)

# **A push that only deletes refs carries no commits, so there is nothing here
# to judge.** git writes one line per ref with an all-zero local sha for a
# deletion, which is the same zero `check-withheld` already skips when it turns
# these lines into ranges. No lines at all is the same answer for the same
# reason: nothing is being transferred.
if ! printf '%s\n' "$pushing" | awk 'NF >= 4 && $2 !~ /^0+$/ { found = 1 } END { exit found ? 0 : 1 }'; then
  printf 'pre-push: deletions only, nothing to verify\n'
  exit 0
fi

printf 'pre-push: withheld names\n'
printf '%s\n' "$pushing" | bun fusion/scripts/check-withheld.mjs --pushing >/tmp/pre-push-$$.log 2>&1 || {
  printf '\n'
  sed 's/^/  /' /tmp/pre-push-$$.log
  printf '\n'
  rm -f /tmp/pre-push-$$.log
  exit 1
}
rm -f /tmp/pre-push-$$.log

# The files the pushed commits change, over the same ranges `check-withheld`
# reads: a new branch from `origin/main`, any other ref from where the remote
# has it. A file a commit deleted is not on disk to format.
changed=$(printf '%s\n' "$pushing" | awk 'NF >= 4 && $2 !~ /^0+$/ {
  if ($4 ~ /^0+$/) print "origin/main.." $2; else print $4 ".." $2
}' | while read -r range; do
  git log --format= --name-only --diff-filter=d "$range"
done | sort -u | while read -r file; do
  if [ -f "$file" ]; then printf '%s\n' "$file"; fi
done)

if [ -z "$changed" ]; then
  printf 'pre-push: clear\n'
  exit 0
fi

printf 'pre-push: formatting and lint\n'
# `--no-errors-on-unmatched`, because a push may change only files biome does
# not read, such as a lockfile or a picture.
printf '%s\n' "$changed" | xargs biome ci --colors=off --no-errors-on-unmatched >/tmp/pre-push-$$.log 2>&1 || {
  printf '\n'
  tail -20 /tmp/pre-push-$$.log | sed 's/^/  /'
  printf '\n  biome refuses a file this push changes. Run `bun run fix` and commit the result.\n\n'
  rm -f /tmp/pre-push-$$.log
  exit 1
}
rm -f /tmp/pre-push-$$.log

printf 'pre-push: clear\n'
