#!/bin/sh
# Refuses a push whose generated files are behind their sources.
#
# **This is the one class CI cannot fix for you.** `verify.yml` runs everything
# on every push, sharded, on a clean checkout, and it is better at all of it than
# a laptop is: types, specs, browsers, Rust. What it cannot do is regenerate.
# `fusion/docs/token-reference.md is behind helix/styles/tokens.json` is a red build that
# stays red until somebody runs `bun run gen:tokens-reference` and pushes again, so catching it
# here saves a round trip rather than duplicating a gate.
#
# **It judges and never writes.** `bun run fix` rewrites files, and a hook that
# edits the tree during `git push` produces a push that does not contain the
# edits, which is worse than the failure it was avoiding. So this reports and
# names the command to run.
#
# Everything else is CI's. There is deliberately no typecheck, no test run and no
# browser here: they are slow, they are already covered, and a hook that takes
# minutes is a hook people pass `--no-verify` to, which costs the checks that
# were worth having.
#
# A second class of check earns a place here: one that is fast and whose failure
# is otherwise silent. `biome ci` was always that and was never
# described, and `check:cli` is the second. The bar is the one this file
# already sets, seconds rather than minutes, and the reason is the same one the
# regeneration argument makes: the cheapest place to learn is before the push.
#
# Installed by `git config core.hooksPath .githooks`, which the `prepare` script
# runs on `bun install`. Skip once with `git push --no-verify`.
set -e

printf 'pre-push: formatting and lint\n'
bunx biome ci . >/dev/null 2>&1 || {
  printf '\n  biome refuses this tree. Run `bun run fix` and commit the result.\n\n'
  exit 1
}

# The list is the generated-file checks, and it is kept in step with `regen` by
# hand: a writer with a `check:` that judges it belongs in both. `element-events`
# was in neither for one night, and the run that found out reported *"the tree is
# unchanged by verifying it"* on three shards, which names nothing.
#
# `themed-page` was in neither for longer, and its failure is the worse shape:
# `verify` runs `check:gen:themed-page`, so CI went red naming the file, and `regen`
# did not write it, so the remedy this repository documents did not produce the
# fix. A check in `verify` whose writer is not in `regen` is a red build with no
# published way out of it.

# **One check here is not about generated files, and it is worth saying why.**
# `check:cli` is the sixteen rules that moved into `helix` and `fusion`, and the
# one that earned this line is `reachable`: it reads `:host([x])` selectors
# against whether `x` reflects, which CI can do perfectly well and does. It is
# here because the fault it catches is silent in every other way: the component
# works, the attribute is correct, and a rule simply never matches for anybody
# who sets the property instead of writing the attribute. Four had drifted before
# it existed, three of them found by rendering pictures rather than by reading
# code, and the cost of finding out on the far side of a push is an afternoon.
#
# **The other fifteen ride along because they are now free.** As a bun script
# reading its own corpus, that one rule cost about a second, which was the bar
# anything joining this list had to clear. As one Rust binary the whole set costs
# 0.7s and the workspace set 1.0s, so the hook covers sixteen rules for less than
# it used to spend on one. That is the argument for the port, arriving where it
# is easiest to measure.
printf 'pre-push: the rules that ship\n'
bun run check:cli >/tmp/pre-push-$$.log 2>&1 || {
  printf '\n'
  grep -v '^\$' /tmp/pre-push-$$.log | tail -4 | sed 's/^/  /'
  printf '\n'
  rm -f /tmp/pre-push-$$.log
  exit 1
}
rm -f /tmp/pre-push-$$.log

printf 'pre-push: generated files\n'
for task in gen:reference gen:element-events gen:tokens-reference gen:tokens-layer \
            gen:metrics gen:docs gen:samples gen:routes gen:content gen:themed-page \
            gen:eval prose:queue; do
  bun run "check:$task" >/tmp/pre-push-$$.log 2>&1 || {
    printf '\n'
    grep -v '^\$' /tmp/pre-push-$$.log | tail -3 | sed 's/^/  /'
    printf '\n'
    rm -f /tmp/pre-push-$$.log
    exit 1
  }
done
rm -f /tmp/pre-push-$$.log

printf 'pre-push: clear\n'
