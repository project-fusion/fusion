{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bunx turbo run build --filter=@fusion.dev/site...",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "visual-baselines-*": false
    }
  },
  "ignoreCommand": "bash fusion/site/scripts/vercel-ignore.sh",
  "installCommand": "bash fusion/site/scripts/vercel-install.sh",
  "outputDirectory": "fusion/site/.next"
}
