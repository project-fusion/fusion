{
  "name": "@cortex-io/docs",
  "description": "Versioned documentation content and registry for Cortex.",
  "version": "0.0.0-dev",
  "license": "UNLICENSED",
  "repository": {
    "directory": "cortex/docs",
    "type": "git",
    "url": "git+https://github.com/former-org/former-repo.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./content/*": "./content/*"
  },
  "files": [
    "content",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
