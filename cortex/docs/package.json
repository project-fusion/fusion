{
  "name": "@fusion.dev/cortex-docs",
  "description": "Versioned documentation content and registry for Cortex.",
  "version": "0.0.2",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "cortex/docs",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./content/*": "./content/*"
  },
  "files": [
    "content",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.types.json",
    "samples": "node scripts/build-samples.mjs",
    "test": "bun test src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "homepage": "https://fusion.dev",
  "keywords": [
    "documentation",
    "memory",
    "provenance",
    "cortex"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
