{
  "name": "@fusion.dev/helix-styles",
  "description": "Design tokens and base layer. Pure CSS, no JavaScript.",
  "version": "0.4.1",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/styles",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "exports": {
    "./all.css": "./dist/all.css",
    "./base.css": "./dist/base.css",
    "./primitives.css": "./dist/primitives.css",
    "./tokens.css": "./dist/tokens.css",
