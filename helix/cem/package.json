{
  "name": "@fusion.dev/helix-cem",
  "description": "The framework typings written from a Helix manifest once `helix manifest build` has written it.",
  "version": "0.108.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "directory": "helix/cem",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "bin": {
    "helix-cem": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "test": "bun test src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fusion.dev/helix-cli": "workspace:*",
    "@wc-toolkit/jsx-types": "^1.7.1"
  },
  "devDependencies": {
    "@wc-toolkit/vuejs-types": "^1.0.1"
  }
}
