{
  "name": "@helix-io/icons",
  "description": "Helix icon set.",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "raw"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run icons && tsc -p tsconfig.json",
    "icons": "node ../../tooling/scripts/build-icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
