{
  "name": "@helix-io/icons",
  "description": "Helix icon set.",
  "version": "0.0.0-dev",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/icons",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "raw"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run icons && tsc -p tsconfig.json",
    "icons": "node ../../tooling/scripts/build-icons.mjs",
    "typecheck": "bun run icons && tsc -p tsconfig.json --noEmit"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "icons",
    "svg",
    "web-components",
    "design-system"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
