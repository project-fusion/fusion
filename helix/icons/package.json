{
  "name": "@helix-io/icons",
  "description": "Helix icon set.",
  "version": "0.0.0-dev",
  "license": "MIT",
  "repository": {
    "directory": "helix/icons",
    "type": "git",
    "url": "git+https://github.com/former-org/former-repo.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "raw"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run icons && tsc -p tsconfig.json",
    "icons": "node ../../tooling/scripts/build-icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
