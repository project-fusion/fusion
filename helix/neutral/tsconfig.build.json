{
  // The authoring helpers the package publishes, and the modules they import,
  // each compiled into `dist` under its own name.
  //
  // **The entry points alone, so the families stay out of `dist`.** Helix's
  // own families import the helpers by path, and `helix family build` writes
  // their compiled forms into `dist/ir` and `dist/web`, which `files` leaves
  // out of the tarball.
  "compilerOptions": {
    "rootDir": "src"
  },
  "extends": "./tsconfig.json",
  "include": [
    "src/jsx-dev-runtime.ts",
    "src/jsx-runtime.ts",
    "src/render.ts",
    "src/style.ts",
    "src/table.ts",
    "src/tree.ts"
  ]
}
