{
  "name": "@fusion.dev/helix-neutral",
  "description": "Experimental helpers for writing the families of a design system, which the Helix family compiler builds for the web and for React Native.",
  "version": "0.223.1",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/neutral",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "exports": {
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./package.json": "./package.json",
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "default": "./dist/style.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "default": "./dist/table.js"
    },
    "./tree": {
      "types": "./dist/tree.d.ts",
      "default": "./dist/tree.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "parts": "helix system parts",
    "parts:watch": "helix system parts --watch",
    "survey:style": "bun scripts/style-survey/main.ts",
    "test": "bun test src scripts --conditions helix-development",
    "typecheck": "bun run parts && tsc -p tsconfig.json --noEmit && helix system parts ../cli/tests/fixtures/acme && tsc -p ../cli/tests/fixtures/acme/tsconfig.json"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "dependencies": {
    "csstype": "^3.2.3"
  },
  "devDependencies": {
    "@fusion.dev/helix": "workspace:*",
    "@fusion.dev/helix-testing": "workspace:*",
    "@lit-labs/ssr": "^4.1.0",
    "css-tree": "^3.2.1",
    "lit": "^3.2.1"
  },
  "homepage": "https://fusion.dev",
  "imports": {
    "#render/jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
    "#render/jsx-runtime": "./src/jsx-runtime.ts"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "helix",
    "jsx",
    "react-native",
    "web-components"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
