{
  "name": "@fusion.dev/helix-core",
  "description": "Helix element primitives: base classes, mixins, decorators, utilities.",
  "version": "0.229.0",
  "license": "MIT",
  "author": "Fusion Development Group",
  "repository": {
    "directory": "helix/core",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./audits/children": {
      "types": "./dist/utils/audit-children/audit-children.d.ts",
      "development": "./dist/utils/audit-children/audit-children.js",
      "helix-development": "./dist/utils/audit-children/audit-children.js",
      "default": "./dist/utils/audit-children/audit-children-off.js"
    },
    "./audits/name": {
      "types": "./dist/utils/audit-name/audit-name.d.ts",
      "development": "./dist/utils/audit-name/audit-name.js",
      "helix-development": "./dist/utils/audit-name/audit-name.js",
      "default": "./dist/utils/audit-name/audit-name-off.js"
    },
    "./audits/nesting": {
      "types": "./dist/utils/audit-nesting/audit-nesting.d.ts",
      "development": "./dist/utils/audit-nesting/audit-nesting.js",
      "helix-development": "./dist/utils/audit-nesting/audit-nesting.js",
      "default": "./dist/utils/audit-nesting/audit-nesting-off.js"
    },
    "./audits/number": {
      "types": "./dist/utils/audit-number/audit-number.d.ts",
      "development": "./dist/utils/audit-number/audit-number.js",
      "helix-development": "./dist/utils/audit-number/audit-number.js",
      "default": "./dist/utils/audit-number/audit-number-off.js"
    },
    "./audits/react": {
      "types": "./dist/helix-element/react-audit.d.ts",
      "development": "./dist/helix-element/react-audit.js",
      "helix-development": "./dist/helix-element/react-audit.js",
      "default": "./dist/helix-element/react-audit-off.js"
    },
    "./audits/served": {
      "types": "./dist/utils/audit-served/audit-served.d.ts",
      "development": "./dist/utils/audit-served/audit-served.js",
      "helix-development": "./dist/utils/audit-served/audit-served.js",
      "default": "./dist/utils/audit-served/audit-served-off.js"
    },
    "./audits/source": {
      "types": "./dist/utils/audit-source/audit-source.d.ts",
      "development": "./dist/utils/audit-source/audit-source.js",
      "helix-development": "./dist/utils/audit-source/audit-source.js",
      "default": "./dist/utils/audit-source/audit-source-off.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json",
    "./words": {
      "types": "./dist/words/index.d.ts",
      "default": "./dist/words/index.js"
    }
  },
  "files": [
    "custom-elements.json",
    "dist"
  ],
  "customElements": "custom-elements.json",
  "sideEffects": false,
  "scripts": {
    "analyze": "bun --bun helix-cem",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json && bun scripts/development-imports.mjs",
    "test": "bun test src --conditions helix-development",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fusion.dev/helix-icons": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@fusion.dev/helix-cem": "workspace:*",
    "@fusion.dev/helix-testing": "workspace:*",
    "@lit-labs/ssr": "^4.1.0",
    "lit": "^3.2.1"
  },
  "homepage": "https://fusion.dev",
  "imports": {
    "#audit-children": {
      "development": "./src/utils/audit-children/audit-children.ts",
      "helix-development": "./src/utils/audit-children/audit-children.ts",
      "default": "./src/utils/audit-children/audit-children-off.ts"
    },
    "#audit-name": {
      "development": "./src/utils/audit-name/audit-name.ts",
      "helix-development": "./src/utils/audit-name/audit-name.ts",
      "default": "./src/utils/audit-name/audit-name-off.ts"
    },
    "#audit-nesting": {
      "development": "./src/utils/audit-nesting/audit-nesting.ts",
      "helix-development": "./src/utils/audit-nesting/audit-nesting.ts",
      "default": "./src/utils/audit-nesting/audit-nesting-off.ts"
    },
    "#audit-number": {
      "development": "./src/utils/audit-number/audit-number.ts",
      "helix-development": "./src/utils/audit-number/audit-number.ts",
      "default": "./src/utils/audit-number/audit-number-off.ts"
    },
    "#audit-served": {
      "development": "./src/utils/audit-served/audit-served.ts",
      "helix-development": "./src/utils/audit-served/audit-served.ts",
      "default": "./src/utils/audit-served/audit-served-off.ts"
    },
    "#audit-source": {
      "development": "./src/utils/audit-source/audit-source.ts",
      "helix-development": "./src/utils/audit-source/audit-source.ts",
      "default": "./src/utils/audit-source/audit-source-off.ts"
    },
    "#react-audit": {
      "development": "./src/helix-element/react-audit.ts",
      "helix-development": "./src/helix-element/react-audit.ts",
      "default": "./src/helix-element/react-audit-off.ts"
    }
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "design-system",
    "helix"
  ],
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
