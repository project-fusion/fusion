{
  "name": "@fusion.dev/helix-core",
  "description": "Helix element primitives: base classes, mixins, decorators, utilities.",
  "version": "0.119.0",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/core",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "custom-elements.json",
    "dist"
  ],
  "customElements": "custom-elements.json",
  "sideEffects": false,
  "scripts": {
    "analyze": "bun --bun helix-cem",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "test": "bun test src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fusion.dev/helix-icons": "workspace:*"
  },
  "devDependencies": {
    "@fusion.dev/helix-cem": "workspace:*",
    "@fusion.dev/helix-testing": "workspace:*",
    "@lit-labs/ssr": "^4.1.0",
    "lit": "^3.2.1"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "design-system",
    "helix"
  ],
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
