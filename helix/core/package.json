{
  "name": "@helix-io/core",
  "description": "Helix element primitives: base classes, mixins, decorators, utilities.",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "custom-elements.json",
    "dist"
  ],
  "customElements": "custom-elements.json",
  "sideEffects": false,
  "scripts": {
    "analyze": "cem analyze --config custom-elements-manifest.config.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@helix-io/icons": "workspace:*"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@helix-io/cem": "workspace:*",
    "lit": "^3.2.1"
  },
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
