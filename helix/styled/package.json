{
  "name": "@fusion.dev/helix",
  "description": "Styled component tier. Extends the headless tier with token-driven presentation.",
  "version": "0.0.9",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/styled",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./elements.css": "./elements.css",
    "./helix.css": "./helix.css",
    "./jsx": "./jsx.d.ts",
    "./svelte": "./svelte.d.ts",
    "./vue": "./vue.d.ts"
  },
  "files": [
    "custom-elements.json",
    "dist",
    "elements.css",
    "helix.css",
    "jsx.d.ts",
    "svelte.d.ts",
    "vue.d.ts"
  ],
  "customElements": "custom-elements.json",
  "sideEffects": true,
  "scripts": {
    "analyze": "cem analyze --config custom-elements-manifest.config.ts",
    "build": "tsc -p tsconfig.json",
    "styles": "build-styles . && build-elements-css .",
    "test": "bun run test:pure && bun run test:dom && bun run test:ssr",
    "test:dom": "bun test dom.spec",
    "test:pure": "bun test pure.spec",
    "test:ssr": "bun test ssr.spec",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "dependencies": {
    "@fusion.dev/helix-core": "workspace:*",
    "@fusion.dev/helix-headless": "workspace:*",
    "@fusion.dev/helix-styles": "workspace:*"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@fusion.dev/helix-cem": "workspace:*",
    "@fusion.dev/helix-testing": "workspace:*",
    "@fusion.dev/scripts": "workspace:*",
    "@happy-dom/global-registrator": "^20.0.0",
    "@lit-labs/ssr": "^3.3.0",
    "@types/bun": "^1.3.0",
    "lit": "^3.2.1"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "design-system",
    "web-components",
    "components",
    "ui",
    "lit"
  ],
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
