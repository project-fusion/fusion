{
  "name": "@fusion.dev/helix",
  "description": "Styled component tier. Extends the headless tier with token-driven presentation.",
  "version": "0.223.1",
  "license": "MIT",
  "author": "Fusion Development Group",
  "repository": {
    "directory": "helix/styled",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    },
    "./api.json": "./api.json",
    "./custom-elements.json": "./custom-elements.json",
    "./examples.json": "./examples.json",
    "./jsx": "./types/jsx.d.ts",
    "./lint.json": "./lint.json",
    "./package.json": "./package.json",
    "./rehype": {
      "types": "./dist/rehype/rehype.d.ts",
      "default": "./dist/rehype/rehype.js"
    },
    "./sandbox/compile-worker.js": "./dist/sandbox/compile-worker.js",
    "./shared": null,
    "./shared/*": null,
    "./skills/*": "./skills/*",
    "./specs": null,
    "./svelte": "./types/svelte.d.ts",
    "./vue": "./types/vue.d.ts",
    "./words": {
      "types": "./types/words.d.ts",
      "default": "./dist/words.js"
    }
  },
  "files": [
    "api.json",
    "custom-elements.json",
    "dist",
    "examples.json",
    "lint.json",
    "skills",
    "types"
  ],
  "customElements": "custom-elements.json",
  "sideEffects": true,
  "scripts": {
    "analyze": "bun --bun helix-cem",
    "build": "bun run element-events && bun run compile-worker && tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "compile-worker": "bun scripts/build-compile-worker.mjs",
    "element-events": "build-element-events --package styled",
    "styles": "build-styles .",
    "test": "bun run element-events && bun run compile-worker && bun run test:pure && bun run test:dom && bun run test:ssr",
    "test:dom": "bun test --conditions helix-development dom.spec",
    "test:pure": "bun test --conditions helix-development pure.spec",
    "test:ssr": "bun test --conditions helix-development ssr.spec",
    "typecheck": "bun run element-events && bun run compile-worker && tsc -p tsconfig.json --noEmit && bun run typecheck:examples",
    "typecheck:examples": "tsc -p tsconfig.examples.json"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "dependencies": {
    "@fusion.dev/helix-core": "workspace:*",
    "@fusion.dev/helix-headless": "workspace:*",
    "@fusion.dev/helix-styles": "workspace:*",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@fusion.dev/helix-cem": "workspace:*",
    "@fusion.dev/helix-testing": "workspace:*",
    "@fusion.dev/scripts": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.1",
    "@lit-labs/ssr": "^4.1.0",
    "@types/bun": "^1.4.3",
    "lit": "^3.2.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "design-system",
    "web-components",
    "components",
    "ui",
    "lit"
  ],
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
