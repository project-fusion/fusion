{
  "name": "@fusion.dev/helix-map",
  "description": "Connects the Helix Map frame to a map renderer: MapLibre, Leaflet, or a driver of your own.",
  "version": "0.134.0",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/map",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./leaflet": {
      "types": "./dist/leaflet/index.d.ts",
      "default": "./dist/leaflet/index.js"
    },
    "./maplibre": {
      "types": "./dist/maplibre/index.d.ts",
      "default": "./dist/maplibre/index.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot/index.d.ts",
      "default": "./dist/snapshot/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "test": "bun run test:pure && bun run test:dom",
    "test:dom": "bun test dom.spec",
    "test:pure": "bun test pure.spec",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "dependencies": {
    "@fusion.dev/helix-core": "workspace:*",
    "@fusion.dev/helix-icons": "workspace:*",
    "@mapbox/vector-tile": "^3.0.0",
    "pbf": "^5.1.2"
  },
  "devDependencies": {
    "@fusion.dev/helix-headless": "workspace:*",
    "@fusion.dev/helix-testing": "workspace:*",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@types/bun": "^1.3.0",
    "@types/leaflet": "^1.9.20",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.11.2"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "map",
    "maplibre",
    "leaflet",
    "accessibility"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
