{
  // What runs at build time, with Bun's types: Metro's config, which Node
  // loads, and the scripts that write the catalog, write the manifests, and
  // serve the export.
  "compilerOptions": {
    "rootDir": "${configDir}"
  },
  "extends": "../../tsconfig.package.json",
  "include": ["metro.config.ts", "scripts/**/*"]
}
