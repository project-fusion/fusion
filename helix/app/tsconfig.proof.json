  // as the web's elements, from the styled tier's typings, and its imports
  // resolve as a browser's do. `helix shared` checks that it uses nothing only
  // the web has.
  "compilerOptions": {
    "customConditions": [],
    "lib": ["ES2023", "DOM"],
    "types": []
  },
  "extends": "./tsconfig.json",
  "include": ["proof/**/*", "../styled/types/jsx.d.ts"]
}
