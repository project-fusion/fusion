{
  "name": "@fusion.dev/helix-graph",
  "description": "Connects the Helix Graph frame to a graph renderer: Sigma.js, or a driver of your own.",
  "version": "0.120.0",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/graph",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sigma": {
      "types": "./dist/sigma/index.d.ts",
      "default": "./dist/sigma/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "test": "bun run test:pure && bun run test:dom",
    "test:dom": "bun test dom.spec",
    "test:pure": "bun test pure.spec",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "dependencies": {
    "@fusion.dev/helix-core": "workspace:*"
  },
  "devDependencies": {
    "@fusion.dev/helix-headless": "workspace:*",
    "@fusion.dev/helix-testing": "workspace:*",
    "@types/bun": "^1.3.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "sigma": "^3.0.3"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "graph",
    "network",
    "sigma",
    "accessibility"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
