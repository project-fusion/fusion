{
  "name": "@fusion.dev/helix-testing",
  "description": "Shared spec helpers for DOM and server-rendered component tests.",
  "version": "0.229.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "directory": "helix/testing",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./conformance/web": {
      "types": "./dist/conformance/web.d.ts",
      "default": "./dist/conformance/web.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./dom/register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./sheets": {
      "types": "./dist/sheets.d.ts",
      "default": "./dist/sheets.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "default": "./dist/ssr.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "test": "bun test src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@lit-labs/ssr": "^4.1.0",
    "@types/bun": "^1.4.4",
    "lit": "^3.2.1"
  }
}
