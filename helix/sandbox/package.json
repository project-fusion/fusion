{
  "name": "@helix-io/sandbox",
  "description": "Sandbox elements: an editable source pane beside a live preview.",
  "version": "0.0.0-dev",
  "private": true,
  "license": "MIT",
  "repository": {
    "directory": "helix/sandbox",
    "type": "git",
    "url": "git+https://github.com/former-org/former-repo.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    },
    "./jsx": "./jsx.d.ts",
    "./svelte": "./svelte.d.ts",
    "./vue": "./vue.d.ts"
  },
  "files": [
    "custom-elements.json",
    "dist",
    "jsx.d.ts",
    "svelte.d.ts",
    "vue.d.ts"
  ],
  "customElements": "custom-elements.json",
  "sideEffects": true,
  "scripts": {
    "analyze": "cem analyze --config custom-elements-manifest.config.ts",
    "build": "tsc -p tsconfig.json",
    "styles": "node ../../tooling/scripts/build-styles.mjs .",
    "test": "bun run test:dom && bun run test:ssr",
    "test:dom": "bun test dom.spec",
    "test:ssr": "bun test ssr.spec",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@helix-io/core": "workspace:*",
    "@helix-io/styles": "workspace:*",
    "@helix-io/web": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@happy-dom/global-registrator": "^20.0.0",
    "@helix-io/cem": "workspace:*",
    "@helix-io/testing": "workspace:*",
    "@lit-labs/ssr": "^3.3.0",
    "@types/bun": "^1.3.0",
    "lit": "^3.2.1"
  },
  "peerDependencies": {
    "lit": "^3.2.1"
  }
}
