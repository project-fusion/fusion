{
  "name": "@fusion.dev/helix-sandbox",
  "description": "Sandbox elements: an editable source pane beside a live preview.",
  "version": "0.4.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "directory": "helix/sandbox",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    },
    "./jsx": "./shared/types/jsx.d.ts",
    "./svelte": "./shared/types/svelte.d.ts",
    "./vue": "./shared/types/vue.d.ts"
  },
  "files": [
    "custom-elements.json",
    "dist",
    "shared"
  ],
  "customElements": "custom-elements.json",
  "sideEffects": true,
  "scripts": {
    "analyze": "cem analyze --config custom-elements-manifest.config.ts",
    "build": "tsc -p tsconfig.json",
    "styles": "build-styles .",
    "test": "bun run test:dom && bun run test:ssr",
    "test:dom": "bun test dom.spec",
    "test:ssr": "bun test ssr.spec",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fusion.dev/helix-core": "workspace:*",
    "@fusion.dev/helix-styles": "workspace:*",
    "@fusion.dev/helix": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@fusion.dev/helix-cem": "workspace:*",
    "@fusion.dev/helix-testing": "workspace:*",
    "@fusion.dev/scripts": "workspace:*",
    "@happy-dom/global-registrator": "^20.0.0",
    "@lit-labs/ssr": "^3.3.0",
    "@types/bun": "^1.3.0",
    "lit": "^3.2.1"
  },
  "peerDependencies": {
    "lit": "^3.2.1"
  }
}
