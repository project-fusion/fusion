{
  "name": "@fusion.dev/helix-sandbox",
  "description": "A CodeMirror source pane for the Helix sandbox, and a code highlighter for Code Block.",
  "version": "0.215.2",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/sandbox",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api.json": "./api.json",
    "./code-block": {
      "types": "./dist/code-block/index.d.ts",
      "default": "./dist/code-block/index.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./examples.json": "./examples.json",
    "./highlight": {
      "types": "./dist/highlight/index.d.ts",
      "default": "./dist/highlight/index.js"
    },
    "./jsx": "./types/jsx.d.ts",
    "./lint.json": "./lint.json",
    "./package.json": "./package.json",
    "./svelte": "./types/svelte.d.ts",
    "./vue": "./types/vue.d.ts",
    "./words": "./types/words.d.ts"
  },
  "files": [
    "api.json",
    "custom-elements.json",
    "dist",
    "examples.json",
    "lint.json",
    "types"
  ],
  "customElements": "custom-elements.json",
  "sideEffects": [
    "./dist/code-block/index.js",
    "./dist/editor/index.js",
    "./dist/sandbox/editor/sandbox-editor.js"
  ],
  "scripts": {
    "analyze": "bun --bun helix-cem",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "styles": "build-styles .",
    "test": "bun run test:dom && bun run test:ssr",
    "test:dom": "bun test dom.spec",
    "test:ssr": "bun test ssr.spec",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fusion.dev/helix-core": "workspace:*",
    "@fusion.dev/helix-headless": "workspace:*",
    "@fusion.dev/helix-styles": "workspace:*",
    "@lezer/css": "^1.3.9",
    "@lezer/highlight": "^1.2.5",
    "@lezer/html": "^1.3.13",
    "@lezer/javascript": "^1.5.6"
  },
  "devDependencies": {
    "@fusion.dev/helix": "workspace:*",
    "@fusion.dev/helix-cem": "workspace:*",
    "@fusion.dev/helix-testing": "workspace:*",
    "@fusion.dev/scripts": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.1",
    "@lit-labs/ssr": "^4.1.0",
    "@types/bun": "^1.4.3",
    "lit": "^3.2.1"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "codemirror",
    "design-system",
    "editor",
    "lezer",
    "lit",
    "sandbox",
    "syntax-highlighting",
    "web-components"
  ],
  "peerDependencies": {
    "@fusion.dev/helix": "workspace:*",
    "lit": "^3.2.1"
  },
  "peerDependenciesMeta": {
    "@fusion.dev/helix": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted"
  }
}
