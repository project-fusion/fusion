{
  "name": "@helix-io/sandbox",
  "description": "Sandbox elements: an editable source pane beside a live preview.",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    },
    "./jsx": "./jsx.d.ts"
  },
  "files": [
    "custom-elements.json",
    "dist",
    "jsx.d.ts"
  ],
  "customElements": "custom-elements.json",
  "sideEffects": true,
  "scripts": {
    "analyze": "cem analyze --config custom-elements-manifest.config.ts",
    "build": "tsc -p tsconfig.json",
    "styles": "node ../../tooling/scripts/build-styles.mjs .",
    "test": "bun run test:dom && bun run test:ssr",
    "test:dom": "bun test dom.spec",
    "test:ssr": "bun test ssr.spec",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@helix-io/core": "workspace:*",
    "@helix-io/styles": "workspace:*"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@fusion-io/testing": "workspace:*",
    "@happy-dom/global-registrator": "^20.0.0",
    "@helix-io/cem": "workspace:*",
    "@lit-labs/ssr": "^3.3.0",
    "@types/bun": "^1.3.0",
    "lit": "^3.2.1"
  },
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
