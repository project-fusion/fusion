    {
      "kind": "javascript-module",
      "path": "src/sandbox/preview/sandbox-preview.ts",
      "declarations": [
        {
          "kind": "class",
          "description": "Renders into the light DOM rather than a shadow root, which is the whole\nreason this is an element and not a `<div>` someone sets `innerHTML` on.\nContent inside a shadow root is cut off from the base layer, so a heading\nwould come out at the browser's default size and a link in the wrong colour,\nand the preview would be a worse likeness the more the design system does.\nIn the light DOM it is styled exactly as it would be on a real page.\n\n**The source is trusted.** It is markup a developer typed into their own\nsandbox, and it is rendered as markup. Never point this at input from anyone\nelse.",
          "name": "HelixSandboxPreview",
          "members": [
            {
              "kind": "field",
              "name": "source",
              "type": {
                "text": "string"
              },
              "default": "''",
              "description": "Markup to render.",
              "attribute": "source"
            },
            {
              "kind": "method",
              "name": "applyStyles",
              "privacy": "private",
              "return": {
                "type": {
                  "text": "void"
                }
              },
              "description": "Puts the stylesheet inside the preview, after the markup.\n\nRe-created whenever the markup is, because setting `innerHTML` removes it\nalong with everything else."
            },
            {
              "kind": "method",
              "name": "finalizeStyles",
              "privacy": "protected",
              "static": true,
              "return": {
                "type": {
                  "text": "CSSResultOrNative[]"
                }
              },
              "parameters": [
                {
                  "name": "styles",
                  "optional": true,
                  "type": {
                    "text": "CSSResultOrNative | CSSResultOrNative[]"
                  }
                }
              ],
              "description": "Prepends the shadow-root reset to every subclass's styles, so no component\nhas to remember to include it.",
              "inheritedFrom": {
                "name": "HelixElement",
                "module": "src/helix-element.ts"
              }
            }
          ],
          "attributes": [
            {
              "name": "source",
              "type": {
                "text": "string"
              },
              "default": "''",
              "description": "Markup to render.",
              "fieldName": "source"
            },
            {
              "name": "styles",
              "type": {
                "text": "string"
              },
              "default": "''",
              "description": "Stylesheet applied to the preview.\n\nScoped by being written into the preview's own subtree rather than the\ndocument, so an example that restyles `helix-card` restyles the one being\npreviewed and not the sandbox around it.",
              "fieldName": "styles"
            }
          ],
