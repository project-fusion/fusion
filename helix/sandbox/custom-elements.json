      "declarations": [
        {
          "kind": "class",
          "description": "Coordination is by event, the same way the accordion does it: a source pane\ndispatches `SourceChange`, which bubbles, and the sandbox hands the value to\nwhatever preview is slotted into it. Neither child knows the other exists, so\neither can be replaced or used alone.\n\nThe event carries the pane's `name`, which is what lets one sandbox hold a\nmarkup pane and a stylesheet pane without the root identifying senders by\nreference. `css` becomes the preview's stylesheet; anything else is markup.\n\nThe split is a real `role=\"separator\"` with `aria-valuenow`, movable by\npointer and by arrow keys, because a divider that only responds to dragging\nis unusable without a mouse. Home and End jump to the bounds.",
          "name": "HelixSandbox",
          "cssProperties": [
            {
              "description": "Minimum height of the sandbox.",
              "name": "--sandbox-min-block-size"
            },
            {
              "description": "Colour of the divider.",
              "name": "--sandbox-separator-color"
            }
          ],
          "cssParts": [
            {
              "description": "The split layout.",
              "name": "container"
            },
            {
              "description": "Either pane.",
              "name": "pane"
            },
            {
              "description": "The draggable divider.",
              "name": "separator"
            }
          ],
          "slots": [
            {
              "description": "The editable source pane.",
              "name": "source"
            },
            {
              "description": "The live preview.",
              "name": "preview"
            }
