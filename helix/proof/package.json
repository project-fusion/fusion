{
  "name": "@fusion.dev/helix-proof",
  "description": "The Helix proof app: a project dashboard on Expo Router, written once and run as a website and in a phone app.",
  "version": "0.223.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "directory": "helix/proof",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "bundle": "expo export --platform web --output-dir dist",
    "start": "expo start",
    "test": "bun run --filter @fusion.dev/helix-native components && bunx --bun jest",
    "theme": "helix theme build --out src/theme.css && helix theme build --format native --out src/theme.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.native.json --noEmit && tsc -p tsconfig.scripts.json --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.14",
    "@floating-ui/react-native": "0.10.10",
    "@fusion.dev/helix": "workspace:*",
    "@fusion.dev/helix-core": "workspace:*",
    "@fusion.dev/helix-icons": "workspace:*",
    "@fusion.dev/helix-native": "workspace:*",
    "@fusion.dev/helix-styles": "workspace:*",
    "expo": "58.0.7",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-haptics": "~58.0.5",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "58.0.11",
    "expo-router": "58.0.17",
    "expo-sharing": "~58.0.16",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0-rc.4",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "jest-expo": "~58.0.9",
    "react-test-renderer": "19.3.1"
  },
  "jest": {
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@fusion\\.dev/helix-core/machines/(.+)/vectors$": "<rootDir>/../core/src/machines/$1/vectors.ts",
      "^@fusion\\.dev/helix-core/machines/reference$": "<rootDir>/../core/src/machines/reference.ts",
      "^@fusion\\.dev/helix-core/route-paths$": "<rootDir>/../core/src/utils/route-paths/route-paths.ts",
      "^@fusion\\.dev/helix-native$": "<rootDir>/../native/src/index.ts",
      "^@fusion\\.dev/helix/expo-router$": "<rootDir>/../styled/native/expo-router/index.native.ts",
      "^@fusion\\.dev/helix/(?!jsx-)(.+)$": "<rootDir>/../native/src/families/$1/index.native.ts",
      "^@fusion\\.dev/helix/jsx-(dev-)?runtime$": "<rootDir>/../styled/native/jsx-runtime/index.native.ts"
    },
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/../native/tests/native.setup.cjs"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.jest.tsx"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|expo-router|react-navigation|@react-navigation|@formatjs))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
