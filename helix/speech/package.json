{
  "name": "@fusion.dev/helix-speech",
  "description": "Speech engines for Helix dictation that recognize in the page, on the device: Moonshine, in WebAssembly.",
  "version": "0.220.0",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/speech",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./worker/*": "./dist/worker/*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json && bun scripts/worker.ts && bun scripts/single-thread.ts",
    "test": "bun run test:pure",
    "test:pure": "bun test pure.spec",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "dependencies": {
    "@fusion.dev/helix-core": "workspace:*",
    "@moonshine-ai/moonshine-wasm": "0.1.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "dictation",
    "moonshine",
    "speech-recognition",
    "speech-to-text",
    "webassembly"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
