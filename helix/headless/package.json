{
  "customElements": "custom-elements.json",
  "dependencies": {
    "@helix-io/core": "workspace:*"
  },
  "description": "Headless component tier. Structure, accessibility, state, and form participation. No styling.",
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@helix-io/cem": "workspace:*",
    "lit": "^3.2.1"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "custom-elements.json",
    "dist"
  ],
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "name": "@helix-io/headless",
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "analyze": "cem analyze --config custom-elements-manifest.config.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.0.1"
}
