{
  "name": "@fusion.dev/helix-headless",
  "description": "Headless component tier. Structure, accessibility, state, and form participation. No styling.",
  "version": "0.206.0",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/headless",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    },
    "./api.json": "./api.json",
    "./custom-elements.json": "./custom-elements.json",
    "./examples.json": "./examples.json",
    "./jsx": "./types/jsx.d.ts",
    "./lint.json": "./lint.json",
    "./specs": null,
    "./svelte": "./types/svelte.d.ts",
    "./vue": "./types/vue.d.ts",
    "./words": "./types/words.d.ts"
  },
  "files": [
    "api.json",
    "custom-elements.json",
    "dist",
    "examples.json",
    "lint.json",
    "types"
  ],
  "customElements": "custom-elements.json",
  "sideEffects": true,
  "scripts": {
    "analyze": "bun --bun helix-cem",
    "build": "bun run element-events && tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "element-events": "build-element-events --package headless",
    "test": "bun run element-events && bun run test:pure && bun run test:dom && bun run test:ssr",
    "test:dom": "split-tests dom.spec --conditions helix-development --preload ./tests/dom.preload.ts",
    "test:pure": "bun test --conditions helix-development pure.spec",
    "test:ssr": "bun test --conditions helix-development ssr.spec",
    "typecheck": "bun run element-events && tsc -p tsconfig.json --noEmit && bun run typecheck:examples",
    "typecheck:examples": "tsc -p tsconfig.examples.json"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "dependencies": {
    "@fusion.dev/helix-core": "workspace:*",
    "@fusion.dev/helix-icons": "workspace:*",
    "tslib": "^2.8.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@fusion.dev/helix-cem": "workspace:*",
    "@fusion.dev/helix-testing": "workspace:*",
    "@fusion.dev/scripts": "workspace:*",
    "@happy-dom/global-registrator": "^20.14.5",
    "@lit-labs/ssr": "^4.1.0",
    "@types/bun": "^1.4.2",
    "lit": "^3.2.1"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "headless-ui",
    "unstyled",
    "web-components",
    "accessible",
    "design-system"
  ],
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
