{
  // The example files, which no other project claims.
  //
  // **`tsconfig.json` excludes `.examples` because `build` must not emit them**,
  // and a file in no project is compiled alone with no `jsx` setting and no
  // typings: every example opens on an error about its own JSX and another about
  // the element it renders. That is what this config is for.
  //
  // **`preserve` rather than `react-jsx`, and `react` is not in `types`.** This
  // package has no React dependency by design, and `react` resolves here only
  // out of the workspace root's hoisted tree, so naming it would be the
  // transitive reach AGENTS.md refuses. `types/jsx.d.ts` carries
  // `declare global { namespace JSX }`, so `preserve` resolves every tag with
  // no framework at all.
  //
  // **Not referenced by `tsconfig.json` and not in `typecheck`.** A referenced
  // composite project that `include`s these files would claim them, and
  // `tsconfig.build.json` records what that costs: the parent stops emitting and
  // `tsc` exits 0 having written nothing.
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "types": ["bun"]
  },
  "exclude": [],
  "extends": "./tsconfig.json",
  "include": ["src/*/.examples/**/*.tsx", "types/jsx.d.ts", ".examples-types/css.d.ts"]
}
