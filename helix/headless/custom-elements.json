              "privacy": "protected"
            },
            {
              "kind": "field",
              "name": "open",
              "type": {
                "text": "boolean | undefined"
              },
              "default": "undefined",
              "description": "Whether the element is open. Setting this puts the element into\ncontrolled mode: the consumer owns the value from that point on.",
              "attribute": "open",
              "reflects": true,
              "inheritedFrom": {
                "name": "WithOpen",
                "module": "src/mixins/with-open.ts"
              }
            },
