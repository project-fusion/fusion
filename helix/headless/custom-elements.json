              "type": {
                "text": "boolean | undefined"
              },
              "privacy": "private",
              "default": "undefined",
              "description": "True when the consumer named the card, so adoption must not overwrite it.\n\nResolved lazily on first update rather than in `connectedCallback`: the SSR\nrenderer applies template attributes around that hook, so reading them\nthere sees the element before the consumer's `aria-label` has landed."
            },
            {
              "kind": "field",
              "name": "ownsLabel",
              "type": {
