              "name": "adoptedTitle",
              "type": {
                "text": "HelixBaseCardTitle | null"
              },
              "privacy": "private",
              "default": "null",
              "description": "The title that announced itself, if any.\n\nNot named `title`: that is `HTMLElement.title`, the tooltip attribute, so\nassigning to it would set a tooltip rather than track an element.\n\nHeld rather than queried. Querying would mean naming the tags that count,\nand the headless tier cannot know the styled tier's tag without depending\nupward on it. The title says what it is instead."
            },
