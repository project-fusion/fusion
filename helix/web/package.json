{
  "name": "@helix-io/web",
  "description": "Styled component tier. Extends the headless tier with token-driven presentation.",
  "version": "0.0.0-dev",
  "license": "MIT",
  "repository": {
    "directory": "helix/web",
    "type": "git",
    "url": "git+https://github.com/former-org/former-repo.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    },
    "./elements.css": "./elements.css",
    "./jsx": "./jsx.d.ts",
    "./svelte": "./svelte.d.ts",
    "./vue": "./vue.d.ts"
  },
  "files": [
    "custom-elements.json",
    "dist",
    "elements.css",
    "jsx.d.ts",
    "svelte.d.ts",
    "vue.d.ts"
  ],
  "customElements": "custom-elements.json",
  "sideEffects": true,
  "scripts": {
    "analyze": "cem analyze --config custom-elements-manifest.config.ts",
    "build": "tsc -p tsconfig.json",
    "styles": "node ../../tooling/scripts/build-styles.mjs . && node ../../tooling/scripts/build-elements-css.mjs .",
    "test": "bun run test:dom && bun run test:ssr",
    "test:dom": "bun test dom.spec",
    "test:ssr": "bun test ssr.spec",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@helix-io/core": "workspace:*",
    "@helix-io/headless": "workspace:*",
    "@helix-io/styles": "workspace:*"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@fusion-io/testing": "workspace:*",
    "@happy-dom/global-registrator": "^20.0.0",
    "@helix-io/cem": "workspace:*",
    "@lit-labs/ssr": "^3.3.0",
    "@types/bun": "^1.3.0",
    "lit": "^3.2.1"
  },
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
