{
  "name": "@fusion.dev/helix-cli",
  "description": "The Helix command line, for a workspace that reaches it through npm, and the visual tests it runs.",
  "version": "0.217.0",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/cli/npm",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "exports": {
    "./bin.mjs": "./bin.mjs",
    "./package.json": "./package.json",
    "./visual": {
      "types": "./visual/index.d.ts",
      "default": "./visual/index.mjs"
    }
  },
  "files": [
    "bin.mjs",
    "visual"
  ],
  "bin": {
    "helix": "./bin.mjs"
  },
  "scripts": {
    "test": "bun test"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "dependencies": {
    "@fusion.dev/helix-templates": "workspace:*"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "helix",
    "cli",
    "design-system",
    "scaffold",
    "theme",
    "playwright",
    "screenshot",
    "visual-regression"
  ],
  "optionalDependencies": {
    "@fusion.dev/helix-cli-darwin-arm64": "workspace:*",
    "@fusion.dev/helix-cli-darwin-x64": "workspace:*",
    "@fusion.dev/helix-cli-linux-arm64": "workspace:*",
    "@fusion.dev/helix-cli-linux-x64": "workspace:*",
    "@fusion.dev/helix-cli-win32-x64": "workspace:*"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.132",
    "playwright": ">=1.50"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted"
  }
}
