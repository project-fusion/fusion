{
  "name": "@fusion.dev/helix-editor",
  "description": "Connects the Helix Editor frame to ProseMirror: a schema whose blocks keep their ids, the editing plugins, and a document drawn in your tokens.",
  "version": "0.223.1",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/editor",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "test": "bun run test:pure && bun run test:dom",
    "test:dom": "bun test dom.spec",
    "test:pure": "bun test pure.spec",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "dependencies": {
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-schema-list": "^1.5.1"
  },
  "devDependencies": {
    "@fusion.dev/helix-headless": "workspace:*",
    "@fusion.dev/helix-testing": "workspace:*",
    "@types/bun": "^1.4.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.6"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "editor",
    "prosemirror",
    "rich-text",
    "contenteditable"
  ],
  "peerDependencies": {
    "prosemirror-model": "^1.25.0",
    "prosemirror-state": "^1.4.0",
    "prosemirror-transform": "^1.10.0",
    "prosemirror-view": "^1.40.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
