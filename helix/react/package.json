{
  "dependencies": {
    "@helix-io/core": "workspace:*",
    "@helix-io/web": "workspace:*"
  },
  "description": "React wrappers around the styled tier. Generated from the custom elements manifest.",
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "name": "@helix-io/react",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.0.1"
}
