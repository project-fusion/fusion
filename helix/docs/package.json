{
  "name": "@fusion.dev/helix-docs",
  "description": "Versioned documentation content and registry for Helix.",
  "version": "0.110.4",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/docs",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./content/*": "./content/*"
  },
  "files": [
    "content",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "docs": "bun scripts/build-docs.mjs",
    "docs-check": "bun scripts/build-docs.mjs --check",
    "metrics": "build-metrics",
    "peers": "bun scripts/build-peers.mjs",
    "test": "bun test src",
    "timings": "bun scripts/build-timings.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "devDependencies": {
    "@fusion.dev/helix-cem": "workspace:*",
    "@fusion.dev/helix-testing": "workspace:*",
    "@fusion.dev/scripts": "workspace:*",
    "lit": "^3.2.1",
    "playwright": "^1.62.1"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "documentation",
    "design-system",
    "mdx",
    "helix"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
