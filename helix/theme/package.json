{
  "name": "@helix-io/theme",
  "description": "Theme derivation engine. Computes a complete, contrast-guaranteed token set from intent inputs.",
  "version": "0.0.0-dev",
  "license": "MIT",
  "repository": {
    "directory": "helix/theme",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../tooling/scripts/build-wasm.mjs && tsc -p tsconfig.json",
    "test": "cargo test -p fusion-helix-theme --manifest-path ../../Cargo.toml",
    "typecheck": "node ../../tooling/scripts/build-wasm.mjs && tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
