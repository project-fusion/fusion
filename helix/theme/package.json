{
  "name": "@fusion.dev/helix-theme",
  "description": "Theme derivation engine. Computes a complete, contrast-guaranteed token set from intent inputs.",
  "version": "0.23.0",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/theme",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.types.json",
    "test": "cargo test -p fusion-helix-theme --manifest-path ../../Cargo.toml",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wasm": "bun scripts/build-wasm.mjs",
    "wasm-check": "bun scripts/check-wasm.mjs"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "devDependencies": {
    "@fusion.dev/scripts": "workspace:*"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "theming",
    "design-tokens",
    "color",
    "oklch",
    "contrast"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
