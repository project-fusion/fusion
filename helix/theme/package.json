{
  "name": "@fusion.dev/helix-theme",
  "description": "Theme derivation engine. Computes a complete token set from intent inputs, and measures every text and background pair it solves against its contrast target.",
  "version": "0.229.0",
  "license": "MIT",
  "author": "Fusion Development Group",
  "repository": {
    "directory": "helix/theme",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./wasm/fusion_helix_theme_bg.wasm": "./wasm/fusion_helix_theme_bg.wasm"
  },
  "files": [
    "dist",
    "wasm"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "test": "bun test src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wasm": "bun scripts/build-wasm.mjs",
    "wasm-check": "bun scripts/check-wasm.mjs"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "devDependencies": {
    "@fusion.dev/scripts": "workspace:*"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "theming",
    "design-tokens",
    "color",
    "oklch",
    "contrast"
  ],
  "publishConfig": {
    "access": "public"
  }
}
