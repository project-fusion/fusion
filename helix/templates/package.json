{
  "name": "@fusion.dev/helix-templates",
  "description": "Starter templates for Helix, as data. Read by `helix new` and by `npm create @fusion.dev/helix-app`.",
  "version": "0.112.0",
  "license": "MIT",
  "author": "Ross Sheppard <ross.sheppard@fusion.dev>",
  "repository": {
    "directory": "helix/templates",
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./templates.json": "./templates.json"
  },
  "files": [
    "dist",
    "templates",
    "templates.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "register": "bun scripts/build-register.mjs",
    "test": "bun run test:pure",
    "test:pure": "bun test pure.spec",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "bugs": "https://github.com/project-fusion/fusion/issues",
  "devDependencies": {
    "@fusion.dev/scripts": "workspace:*"
  },
  "homepage": "https://fusion.dev",
  "keywords": [
    "helix",
    "templates",
    "scaffold",
    "design-system"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
