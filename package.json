    "check:reflected-defaults": "node tooling/scripts/check-reflected-defaults.mjs",
    "check:registration": "node tooling/scripts/check-registration.mjs",
    "check:repository": "node tooling/scripts/check-repository.mjs",
    "check:routes": "bun tooling/scripts/check-routes.mjs",
