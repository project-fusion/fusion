    "check:parts": "node tooling/scripts/check-parts.mjs",
    "check:platform-fidelity": "node tooling/scripts/check-platform-fidelity.mjs",
    "check:prerequisites": "node tooling/scripts/check-prerequisites.mjs",
    "check:print": "node tooling/scripts/check-print.mjs",
    "check:publishable": "node tooling/scripts/check-publishable.mjs",
    "check:queue": "node tooling/scripts/check-queue.mjs",
    "check:reachable": "bun tooling/scripts/check-reachable.mjs",
    "check:react-bridge": "node tooling/scripts/check-react-bridge.mjs",
