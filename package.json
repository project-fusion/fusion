    "check:tokens": "node tooling/scripts/check-tokens.mjs",
    "check:tokens-layer": "bun tooling/scripts/build-token-layer.mjs --check",
    "check:tokens-reference": "node tooling/scripts/build-tokens.mjs --check",
    "check:visual": "node tooling/scripts/check-visual.mjs",
    "check:visual-parity": "bun tooling/scripts/check-visual-parity.mjs",
    "check:vocabulary": "node tooling/scripts/check-part-vocabulary.mjs",
    "check:wasm": "node tooling/scripts/check-wasm.mjs",
