{
  "name": "@fusion.dev/source",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/project-fusion/fusion.git"
  },
  "scripts": {
    "analyze": "turbo run analyze",
    "build": "turbo run build",
    "check": "bun run check:cli && bun run check:css && bun run check:gen && bun run check:prose && bun run check:spec",
    "check:cli": "bun run check:cli:component && bun run check:cli:workspace",
    "check:cli:component": "bun run helix component audit",
    "check:cli:workspace": "bun run fusion workspace audit",
    "check:css": "bun run check:css:contrast && bun run check:css:seeds && bun run check:css:wasm",
    "check:css:contrast": "node fusion/scripts/check-contrast.mjs",
    "check:css:seeds": "bun run helix component check --only seeds",
    "check:css:wasm": "bun run --filter @fusion.dev/helix-theme wasm-check",
    "check:gen": "bun run check:gen:content && bun run check:gen:docs && bun run check:gen:element-events && bun run check:gen:eval && bun run check:gen:metrics && bun run check:gen:reference && bun run check:gen:routes && bun run check:gen:samples && bun run check:gen:themed-page && bun run check:gen:tokens-layer && bun run check:gen:tokens-reference",
    "check:gen:content": "bun run --filter @fusion.dev/docs content --check",
    "check:gen:docs": "bun run --filter @fusion.dev/helix-docs docs --check",
    "check:gen:element-events": "node fusion/scripts/build-element-events.mjs --check",
    "check:gen:eval": "node fusion/scripts/build-eval.mjs --check && node fusion/scripts/run-eval.mjs --check",
    "check:gen:metrics": "bun fusion/scripts/build-metrics.mjs --check",
    "check:gen:reference": "bun run --filter @fusion.dev/docs reference --check",
    "check:gen:routes": "bun run --filter @fusion.dev/docs routes --check",
    "check:gen:samples": "bun run --filter @fusion.dev/cortex-docs samples --check",
    "check:gen:themed-page": "bun run --filter @fusion.dev/site themed-page --check",
    "check:gen:tokens-layer": "bun run --filter @fusion.dev/helix-styles token-layer --check",
    "check:gen:tokens-reference": "bun run --filter @fusion.dev/docs tokens --check",
    "check:prose": "bun run fusion prose check",
    "check:spec": "bun run fusion spec check && bun run check:spec:diagnostics && bun run check:spec:floors && bun run check:spec:visual && bun run check:spec:visual-parity",
    "check:spec:diagnostics": "bun fusion/scripts/check-diagnostics.mjs",
    "check:spec:floors": "node fusion/scripts/check-floors.mjs",
    "check:spec:visual": "node fusion/scripts/check-visual.mjs",
    "check:spec:visual-parity": "bun fusion/scripts/check-visual-parity.mjs",
    "clean": "rm -rf node_modules target **/dist **/node_modules .turbo",
    "dev": "turbo run dev",
    "eval": "node fusion/scripts/run-eval.mjs",
    "fix": "bun run fix:order && bun run fix:format && bun run fix:examples && bun run fix:dialect && bun run fix:tag-order && bun run helix component check --only tokens",
    "fix:dialect": "bun run fusion prose fix --only dialect",
    "fix:examples": "node fusion/scripts/format-examples.mjs --write",
    "fix:format": "biome check --write .",
    "fix:order": "bun run fusion workspace fix",
    "fix:tag-order": "bun run fusion prose fix --only tag-order",
    "fusion": "node fusion/cli/npm/bin.mjs",
    "gen:catalog": "bun run --filter @fusion.dev/site catalog",
    "gen:content": "bun run --filter @fusion.dev/docs content",
    "gen:docs": "bun run --filter @fusion.dev/helix-docs docs",
    "gen:element-events": "node fusion/scripts/build-element-events.mjs",
    "gen:eval": "node fusion/scripts/build-eval.mjs",
    "gen:faces": "bun run --filter @fusion.dev/site faces",
    "gen:frame": "bun run --filter @fusion.dev/site frame",
    "gen:metrics": "bun fusion/scripts/build-metrics.mjs",
    "gen:peers": "bun run --filter @fusion.dev/helix-docs peers",
    "gen:reference": "bun run --filter @fusion.dev/docs reference",
    "gen:routes": "bun run --filter @fusion.dev/docs routes",
    "gen:samples": "bun run --filter @fusion.dev/cortex-docs samples",
    "gen:specs": "bun run --filter @fusion.dev/site specs",
    "gen:styles-dist": "bun run --filter @fusion.dev/helix-styles styles-dist",
    "gen:themed-page": "bun run --filter @fusion.dev/site themed-page",
    "gen:timings": "bun run --filter @fusion.dev/helix-docs timings",
    "gen:tokens-layer": "bun run --filter @fusion.dev/helix-styles token-layer",
    "gen:tokens-reference": "bun run --filter @fusion.dev/docs tokens",
    "gen:wasm": "bun run --filter @fusion.dev/helix-theme wasm",
    "helix": "node helix/cli/npm/bin.mjs",
    "insight": "bun fusion/scripts/new-insight.mjs",
    "lint": "biome lint .",
    "prepare": "git config core.hooksPath .githooks",
    "probe:stuck": "bun fusion/scripts/probe-stuck-spec.mjs",
    "regen": "bun run fix && bun run analyze && bun run gen:element-events && bun run gen:reference && bun run gen:tokens-layer && bun run gen:tokens-reference && bun run gen:metrics && bun run gen:routes && bun run gen:samples && bun run gen:docs && bun run gen:content && bun run gen:catalog && bun run gen:themed-page && bun run gen:eval",
    "rs:build": "cargo build --workspace",
    "rs:check": "cargo clippy --workspace --all-targets -- -D warnings",
    "rs:fmt": "cargo fmt --all",
    "rs:test": "cargo test --workspace",
    "shot": "node fusion/scripts/shot.mjs",
    "smoke:examples": "node fusion/scripts/run-example-smoke.mjs",
    "smoke:template": "node fusion/scripts/run-template-test.mjs",
    "specs:browser": "bun run gen:specs && node fusion/scripts/run-browser-specs.mjs",
    "styles": "turbo run styles",
    "test": "turbo run test",
    "trust": "node fusion/scripts/trust.mjs",
    "typecheck": "turbo run typecheck",
    "verify": "biome ci . && bun run check:cli && bun run check:gen:tokens-layer && bun run typecheck && bun run analyze && bun run check:gen:docs && bun run check:gen:samples && bun run check:gen:eval && bun run check:gen:content && bun run gen:catalog && bun run check:gen:routes && bun run check:gen:reference && bun run check:gen:tokens-reference && bun run check:gen:metrics && bun run check:css:seeds && bun run check:css:wasm && bun run check:prose && bun run check:gen:themed-page && bun run check:gen:element-events && bun run fusion spec check && bun run check:spec:floors && bun run test && bun run rs:check && bun run rs:test",
    "visual:update": "node fusion/scripts/check-visual.mjs --update",
    "watch": "turbo watch frame catalog --filter=@fusion.dev/site"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@fusion.dev/scripts": "workspace:*",
    "@happy-dom/global-registrator": "^20.11.2",
    "@lit-labs/nextjs": "^0.2.4",
    "@lit-labs/ssr": "^4.1.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wc-toolkit/jsx-types": "^1.7.1",
    "happy-dom": "^20.11.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "turbo": "^2.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.18"
  },
  "packageManager": "bun@1.1.43",
  "workspaces": [
    "cortex/docs",
    "fusion/cli/npm",
    "fusion/docs",
    "fusion/docs/insights",
    "fusion/scripts",
    "fusion/site",
    "helix/*",
    "helix/cli/npm"
  ]
}
