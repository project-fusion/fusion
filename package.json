    "lint": "biome lint .",
    "metrics": "bun tooling/scripts/build-metrics.mjs",
    "metrics:peers": "bun tooling/scripts/build-peers.mjs",
    "metrics:timing": "bun tooling/scripts/build-timings.mjs",
