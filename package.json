    "tokens": "node tooling/scripts/build-tokens.mjs",
    "tokens:build": "bun tooling/scripts/build-token-layer.mjs",
    "trust": "node tooling/scripts/trust.mjs",
    "typecheck": "turbo run typecheck",
    "verify": "bun run check:node && biome ci . && bun run check:publishable && bun run check:tokens && bun run check:tokens-layer && bun run check:prerequisites && bun run typecheck && bun run analyze && bun run check:examples && bun run check:examples-paired && bun run check:example-values && bun run check:icons && bun run check:queue && bun run check:dialect && bun run check:tag-order && bun run check:docs && bun run check:samples && bun run check:documented && bun run check:eval && bun run check:content && bun run catalog && bun run check:routes && bun run check:reference && bun run check:tokens-reference && bun run check:metrics && bun run check:pairings && bun run check:seeds && bun run check:separation && bun run check:scoped && bun run check:selectors && bun run check:overruled && bun run check:attributes && bun run check:categories && bun run check:modules && bun run check:composed && bun run check:shipped && bun run check:seams && bun run check:barrels && bun run check:fallbacks && bun run check:references && bun run check:repository && bun run check:registration && bun run check:reflected && bun run check:reflected-defaults && bun run check:reachable && bun run check:leaks && bun run check:disabled && bun run check:motion && bun run check:observers && bun run check:orphans && bun run check:shaders && bun run check:hooks && bun run check:grounds && bun run check:parts && bun run check:exportparts && bun run check:vocabulary && bun run check:print && bun run check:art && bun run check:themed-page && bun run check:tier && bun run check:axes && bun run check:events && bun run check:element-events && bun run check:react-bridge && bun run check:matchers && bun run check:spec-hazards && bun run check:spec-runners && bun run check:specs && bun run check:specs-isolated && bun run check:stable && bun run check:floors && bun run test && bun run rs:check && bun run rs:test",
    "visual:update": "node tooling/scripts/check-visual.mjs --update",
    "wasm": "node tooling/scripts/build-wasm.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@happy-dom/global-registrator": "^20.11.2",
    "@lit-labs/nextjs": "^0.2.4",
    "@lit-labs/ssr": "^4.1.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wc-toolkit/jsx-types": "^1.7.1",
    "happy-dom": "^20.11.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "turbo": "^2.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.18"
  },
  "packageManager": "bun@1.1.43",
