    "check:scoped": "node tooling/scripts/check-scoped.mjs",
    "check:seams": "node tooling/scripts/check-seams.mjs",
    "check:seeds": "node tooling/scripts/check-seeds.mjs",
    "check:selectors": "node tooling/scripts/check-selectors.mjs",
    "check:separation": "node tooling/scripts/check-separation.mjs",
    "check:shaders": "node tooling/scripts/check-shaders.mjs",
    "check:shipped": "node tooling/scripts/check-shipped.mjs",
