{
  "name": "@fusion-io/source",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "customElements": "custom-elements.json",
  "scripts": {
    "analyze": "turbo run analyze",
    "build": "turbo run build",
    "check": "bun run order && biome check --write . && bun run check:tokens",
    "check:tokens": "node tooling/scripts/check-tokens.mjs",
    "clean": "rm -rf node_modules target **/dist **/node_modules .turbo",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "order": "node tooling/scripts/order-manifests.mjs",
    "rs:build": "cargo build --workspace",
    "rs:check": "cargo clippy --workspace --all-targets -- -D warnings",
    "rs:fmt": "cargo fmt --all",
    "rs:test": "cargo test --workspace",
    "styles": "turbo run styles",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "biome ci . && bun run check:tokens && bun run typecheck && bun run analyze && bun run test && bun run rs:check && bun run rs:test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@happy-dom/global-registrator": "^20.11.2",
    "@lit-labs/nextjs": "^0.2.4",
    "@lit-labs/ssr": "^4.1.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wc-toolkit/jsx-types": "^1.7.1",
    "happy-dom": "^20.11.2",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.1.43",
  "workspaces": [
    "cortex/docs",
    "helix/*",
    "site/*",
    "tooling/*"
  ]
}
