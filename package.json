{
  "name": "@fusion-io/source",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "customElements": "custom-elements.json",
  "scripts": {
    "analyze": "turbo run analyze",
    "build": "turbo run build",
    "check": "bun run order && biome check --write . && node tooling/scripts/format-examples.mjs --write && bun run check:tokens",
    "check:controlled": "node tooling/scripts/check-controlled.mjs",
    "check:events": "node tooling/scripts/check-events.mjs",
    "check:examples": "node tooling/scripts/check-examples.mjs && node tooling/scripts/format-examples.mjs",
    "check:floors": "node tooling/scripts/check-floors.mjs",
    "check:grounds": "node tooling/scripts/check-grounds.mjs",
    "check:hooks": "node tooling/scripts/check-hooks.mjs",
    "check:leaks": "node tooling/scripts/check-leaks.mjs",
    "check:icons": "node tooling/scripts/check-icons.mjs",
    "check:composed": "node tooling/scripts/check-composed.mjs",
    "check:disabled": "node tooling/scripts/check-disabled.mjs",
    "check:overruled": "node tooling/scripts/check-overruled.mjs",
    "check:parts": "node tooling/scripts/check-parts.mjs",
    "check:publishable": "node tooling/scripts/check-publishable.mjs",
    "check:queue": "node tooling/scripts/check-queue.mjs",
    "check:react-bridge": "node tooling/scripts/check-react-bridge.mjs",
    "check:reference": "node tooling/scripts/build-reference.mjs --check",
    "check:tokens-reference": "node tooling/scripts/build-tokens.mjs --check",
    "check:references": "node tooling/scripts/check-references.mjs",
    "check:reflected": "node tooling/scripts/check-reflected.mjs",
    "check:seams": "node tooling/scripts/check-seams.mjs",
    "check:selectors": "node tooling/scripts/check-selectors.mjs",
    "check:shaders": "node tooling/scripts/check-shaders.mjs",
    "check:specs": "node tooling/scripts/check-specs.mjs",
    "check:stable": "node tooling/scripts/check-stable.mjs",
    "check:tokens": "node tooling/scripts/check-tokens.mjs",
    "clean": "rm -rf node_modules target **/dist **/node_modules .turbo",
    "dev": "turbo run dev",
    "dev:watch": "turbo watch frame --filter=@fusion-io/site-ui",
    "format": "biome format --write .",
    "frame": "bun tooling/scripts/build-frame.mjs",
    "reference": "node tooling/scripts/build-reference.mjs",
    "tokens": "node tooling/scripts/build-tokens.mjs",
    "trust": "node tooling/scripts/trust.mjs",
    "lint": "biome lint .",
    "order": "node tooling/scripts/order-manifests.mjs",
    "rs:build": "cargo build --workspace",
    "rs:check": "cargo clippy --workspace --all-targets -- -D warnings",
    "rs:fmt": "cargo fmt --all",
    "rs:test": "cargo test --workspace",
    "specs": "bun tooling/scripts/build-specs.mjs",
    "specs:browser": "bun run specs && node tooling/scripts/run-browser-specs.mjs",
    "smoke": "node tooling/scripts/run-example-smoke.mjs",
    "styles": "turbo run styles",
    "test": "turbo run test",
    "test:template": "node tooling/scripts/run-template-test.mjs",
    "typecheck": "turbo run typecheck",
    "verify": "biome ci . && bun run check:publishable && bun run check:tokens && bun run typecheck && bun run analyze && bun run check:examples && bun run check:icons && bun run check:queue && bun run check:reference && bun run check:tokens-reference && bun run check:selectors && bun run check:overruled && bun run check:composed && bun run check:seams && bun run check:references && bun run check:reflected && bun run check:leaks && bun run check:disabled && bun run check:motion && bun run check:observers && bun run check:shaders && bun run check:hooks && bun run check:grounds && bun run check:parts && bun run check:art && bun run check:events && bun run check:controlled && bun run check:react-bridge && bun run check:specs && bun run check:stable && bun run check:floors && bun run test && bun run rs:check && bun run rs:test",
    "check:motion": "node tooling/scripts/check-motion.mjs",
    "check:observers": "node tooling/scripts/check-observers.mjs",
    "check:art": "node tooling/scripts/check-art.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@happy-dom/global-registrator": "^20.11.2",
    "@lit-labs/nextjs": "^0.2.4",
    "@lit-labs/ssr": "^4.1.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wc-toolkit/jsx-types": "^1.7.1",
    "happy-dom": "^20.11.2",
    "playwright": "^1.62.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.11"
  },
  "packageManager": "bun@1.1.43",
  "workspaces": [
    "cortex/docs",
    "helix/*",
    "site/*",
    "tooling/*"
  ]
}
