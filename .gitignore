# Per-machine scratch.
.local/

# Dependencies
node_modules/
.pnp.*

# Build output
*.css.ts
*.tsbuildinfo
.next/
.next-dev/
.turbo/
dist/
out/
target/
.vercel

# Env. `.env.template` is the one that ships, so nothing broader than these.
.env
.env.*
!.env.template

# OS and editor
.DS_Store
*.swp
.idea/
.vscode/

# Logs
*.log
bun-debug.log*
npm-debug.log*

# Generated sources, each written by its own package's `build`.
helix/icons/src/generated.ts
helix/icons/src/*.generated.ts
helix/*/src/element-events.generated.ts
helix/styled/src/sandbox/compile-worker.generated.ts
# The native components `helix family components` writes, each carrying its
# family's intermediate forms, which change with every style rule: the ones
# the styled package compiles, and the ones the native package's specs draw.
helix/styled/native/*
# The JSX runtime and the Expo Router entry beside them are written by hand.
!helix/styled/native/expo-router/
!helix/styled/native/jsx-runtime/
!helix/styled/native/jsx-dev-runtime/
helix/native/src/families/*/
# What `helix family types` and `helix family tokens` write into the runtime:
# the intermediate form's types, and a token module per mode. The package's
# `generate` writes them before it builds, checks, or tests.
helix/native/src/ir.generated.ts
helix/native/src/theme/*.generated.ts
helix/styled/src/**/*.generated.css
# The gallery app's catalog of examples, and what Expo writes beside an app:
# its own folder, and the native projects `expo prebuild` writes for a build.
helix/app/src/examples.generated.ts
helix/app/.expo/
helix/app/android/
helix/app/ios/
# The theme engine `helix/native/scripts/engine.mjs` builds for phones: the
# libraries and the Swift and Kotlin UniFFI writes for them. The release builds
# them and the package carries them.
helix/native/android/src/engine/
helix/native/ios/theme/engine/
helix/*/.tsbuild
helix/speech/vendor/
helix/styles/src/elements.css
helix/styles/src/tokens.css
fusion/site/content/catalog/catalog.generated.json
fusion/site/content/native/native.generated.json
fusion/docs/insights/src/pages.generated.ts
fusion/docs/insights/src/sources.generated.ts
fusion/site/app/*/helix/theme/themed-page-markup.generated.ts
helix/docs/src/pages.generated.ts
helix/docs/src/sources.generated.ts
helix/docs/content/metrics.mdx
fusion/site/content/faces/faces.generated.ts
fusion/site/content/landing/claims.generated.ts
fusion/scripts/eval/questions.json
# The conformance record the web half wrote here until October 12, 2026. Each
# half now writes its own under `.local/conformance`, and a copy left in a
# checkout from before stays out of a commit.
helix/testing/src/conformance/record.json

# What `analyze` writes: nine megabytes nobody reads in a diff. Untracked,
# it cannot go stale, because every consumer builds it. See d350fe53f.
custom-elements.json
# The lint data `analyze` writes beside each tier's manifest, for diagnostics.
helix/*/lint.json
# The catalog and examples `analyze` writes beside it, for `helix mcp`.
helix/*/api.json
helix/*/examples.json
# The agent skill `analyze` writes from the documentation, for the package.
helix/*/skills/
# The Claude Code plugin's skill is committed: a plugin installs from the
# repository as it stands, and `check:gen:eval` holds it to the packaged one.
!helix/plugin/skills/
jsx.d.ts
svelte.d.ts
vue.d.ts
helix/*/types/words.d.ts

# Served by the dev server, generated or scratch. Ignored rather than tracked
# because `biome ci` lints what it can see, and a generated page failing lint
# fails the push.
fusion/site/public/*.md
fusion/site/public/.probe/
fusion/site/public/_lab/
fusion/site/public/check
fusion/site/public/helix/*.md
fusion/site/public/helix/components/
fusion/site/public/helix/docs/
fusion/site/public/insights/
fusion/site/public/probe-events/
fusion/site/public/sandbox
fusion/site/public/specs

# The theme engine the site serves, copied from `helix/theme/wasm` by
# `turbo run wasm-copy`. The tracked binary is the one in the package.
fusion/site/public/helix/theme.wasm
fusion/site/public/helix-speech/
# The Helix gallery Expo Go opens, copied from `helix/app/dist` with manifests
# for the deploy's own address by `scripts/copy-helix-app.mjs`.
fusion/site/public/helix/app/
# MapLibre's worker and its shared module, copied from the installed package by
# `scripts/copy-maplibre.mjs`.
fusion/site/public/maplibre/

# The artifact a failed visual comparison leaves behind. What belongs in the
# history is the baseline a reviewer approved, not the run that disagreed.
*.diff.png
# The reports `helix visual` writes on every run, beside each config: the
# examples', parity's, and hydration's.
**/.helix/visual/
**/.helix/parity/
**/.helix/dsd/

# A second checkout of this repo, so tracking it would track everything twice.
.claude/worktrees/

# One tool's per-machine config: a preview command and a permission allowlist.
# None of it is a fact about this repository.
.claude/launch.json
.claude/settings.json
.claude/settings.local.json

# The `helix` binary each platform package ships, placed by the release and never
# committed: a checkout builds its own into `target/`.
helix/cli/platforms/*/helix
helix/cli/platforms/*/helix.exe

# The `cortex` binary each of its platform packages ships, for the same reason.
cortex/cli/platforms/*/cortex
cortex/cli/platforms/*/cortex.exe

