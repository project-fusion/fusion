# Per-machine scratch.
.local/

# Dependencies
node_modules/
.pnp.*

# Build output
*.css.ts
*.tsbuildinfo
.next/
.next-dev/
.turbo/
dist/
out/
target/
.vercel

# Env. `.env.template` is the one that ships, so nothing broader than these.
.env
.env.*
!.env.template

# OS and editor
.DS_Store
*.swp
.idea/
.vscode/

# Logs
*.log
bun-debug.log*
npm-debug.log*

# Generated sources, each written by its own package's `build`.
helix/icons/src/generated.ts
helix/*/src/element-events.generated.ts
helix/*/.preview/.tsbuild
helix/*/.tsbuild
cortex/*/.tsbuild
helix/styles/src/elements.css
helix/styles/src/tokens.css
fusion/site/content/catalog/catalog.generated.json
fusion/docs/insights/src/pages.generated.ts
fusion/docs/insights/src/sources.generated.ts
fusion/site/app/*/helix/theme/themed-page-markup.generated.ts

# What `cem analyze` writes: nine megabytes nobody reads in a diff. Untracked,
# it cannot go stale, because every consumer builds it. See d350fe53f.
custom-elements.json
jsx.d.ts
svelte.d.ts
vue.d.ts

# Served by the dev server, generated or scratch. Ignored rather than tracked
# because `biome ci` lints what it can see, and a generated page failing lint
# fails the push.
fusion/site/public/*.md
fusion/site/public/.probe/
fusion/site/public/_lab/
fusion/site/public/check
fusion/site/public/helix/*.md
fusion/site/public/helix/components/
fusion/site/public/helix/docs/
fusion/site/public/insights/
fusion/site/public/probe-events/
fusion/site/public/sandbox
fusion/site/public/specs

# Recapture with `bun tooling/scripts/capture-scale-film.mjs`.
fusion/site/public/media/sovereignty.jpg
fusion/site/public/media/sovereignty.webm

# The artifact a failed visual comparison leaves behind. What belongs in the
# history is the baseline a reviewer approved, not the run that disagreed.
*.diff.png
*.parity.png

# A second checkout of this repo, so tracking it would track everything twice.
.claude/worktrees/

# One tool's per-machine config: a preview command and a permission allowlist.
# None of it is a fact about this repository.
.claude/launch.json
.claude/settings.json
.claude/settings.local.json
