# Local-only artifacts, per-machine. Never committed.
.local/

# Dependencies
node_modules/
.pnp.*

# Build output
*.css.ts
dist/
target/
.next/
out/
.turbo/
*.tsbuildinfo

# Env
.env
.env.*
!.env.template

# OS / editor
.DS_Store
*.swp
.idea/

# Logs
*.log
npm-debug.log*
bun-debug.log*

# Generated light-DOM stylesheet, built from the element sources.
helix/*/elements.css

# Generated sandbox page.
sandbox/ui/dist/
.vercel
.env*

# Generated vision film. Recapture with `bun tooling/scripts/capture-scale-film.mjs`.
site/ui/public/media/sovereignty.jpg
site/ui/public/media/sovereignty.webm

# Generated icon set, built from raw/.
helix/icons/src/generated.ts

# Dev server output, kept apart from the cached `.next` build.
.next-dev/

# Spec bundles for the sandbox, built from the spec files by `bun run specs`.
site/ui/public/specs

# The sandbox preview document, built from source by `bun run frame`.
site/ui/public/sandbox

# Worktrees an agent made for isolation. A second checkout of this repo, so
# tracking it would track everything twice and linting it collides with this
# tree's own root config.
.claude/worktrees/

# Measurement scratch: pages written to probe layout and paint, never shipped.
site/ui/public/.probe/

# The artifact a failed visual comparison leaves behind, marked with the pixels
# that moved. What belongs in the history is the baseline a reviewer approved,
# not the picture of a run that disagreed with it.
*.diff.png

# Derived from the manifests and the example files by `bun run catalog`.
site/ui/lib/catalog.generated.json
site/ui/public/components/
